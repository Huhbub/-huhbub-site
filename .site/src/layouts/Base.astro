---
export interface Props {
  title?: string;
}
const { title = "huhbub — creating experiences for creative people" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&family=Nunito:wght@300;400;600&family=Caveat:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'DM Sans', system-ui, sans-serif;
      --font-logo: 'Nunito', system-ui, sans-serif;
      --font-handwriting: 'Caveat', cursive;

      --sky: #07051A;
      --sky-mid: #0E0B2E;
      --accent: #D4537E;
      --accent-soft: #F5A7CC;
      --accent-gold: #EF9F27;
      --accent-purple: #7F77DD;
      --text-primary: #F5F0FF;
      --text-secondary: #9B96CC;
      --border-subtle: rgba(255,255,255,0.08);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body { font-family: var(--font-body); background: var(--sky); color: var(--text-primary); overflow-x: hidden; }
    h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 400; }
    a { color: inherit; text-decoration: none; }
    ::selection { background: var(--accent); color: #fff; }

    /* PAGE FADE-IN */
    #site { animation: site-arrive 0.4s ease forwards; }
    @keyframes site-arrive { from { opacity: 0; } to { opacity: 1; } }

    /* NAV TABS */
    .nav-links { display: flex; align-items: flex-end; gap: 0; margin-left: 48px; }
    .nav-links a {
      position: relative; display: inline-block;
      padding: 6px 14px 10px; font-size: 12px;
      color: rgba(20,10,40,0.7) !important; font-weight: 500;
      text-shadow: none !important;
      border-radius: 6px 8px 0 0; margin-right: 2px;
      background: #E8D8F0;
      box-shadow: 1px -2px 8px rgba(0,0,0,0.1), inset 0 1px 0 rgba(255,255,255,0.5);
      clip-path: polygon(0 100%, 0 8px, 6px 0, 100% 0, 100% 8px, 100% 100%);
      transition: filter 0.2s;
      z-index: 1;
    }
    .nav-links a[href="/services"]  { background: #FAD9A0; }
    .nav-links a[href="/projects"]  { background: #F5C8DC; }
    .nav-links a[href="/events"]    { background: #B8E8D8; }
    .nav-links a[href="/about"]     { background: #F5B8C4; }
    .nav-links a[href="/stories"]   { background: #D4C8F0; }
    .nav-links a[href="/contact"]   { background: #B8CCF0; }
    .nav-links a:hover { filter: brightness(1.08); color: rgba(10,5,30,0.9) !important; }
    .nav-links a.active { filter: brightness(1.05) saturate(1.1); z-index: 10; color: rgba(10,5,30,0.9) !important; }
    .nav-links a::after { display: none; }
    .nav-links a, .nav-links a.active { border-bottom: none !important; }

    /* Mobile menu always on top */
    .mobile-menu { z-index: 9000 !important; }
    .nav-burger { position: relative; z-index: 101; }

    /* Nav top padding */
    nav { padding-top: 28px !important; padding-bottom: 0 !important; overflow: visible !important; }
  </style>
</head>
<body>
  <slot />
  <script>
    // Folder tab bar — set nav border-bottom to match active tab
    (function() {
      const TAB_COLORS = {
        '/':         '#E8E0F8',
        '/services': '#FAD9A0',
        '/projects': '#F5C8DC',
        '/events':   '#B8E8D8',
        '/about':    '#F5B8C4',
        '/stories':  '#D4C8F0',
        '/people':   '#C8E0F8',
        '/press':    '#D4E8C8',
        '/contact':  '#B8CCF0',
      };
      const nav = document.querySelector('nav');
      if (!nav) return;
      const homeMarker = nav.querySelector('.nav-home-active');
      const active = homeMarker ? null : nav.querySelector('.nav-link.active');
      const href = homeMarker ? '/' : active?.getAttribute('href');
      const color = TAB_COLORS[href] || TAB_COLORS['/'];
      nav.style.borderBottom = `8px solid ${color}`;
      if (active) {
        active.style.setProperty('background', color, 'important');
        active.style.setProperty('border-radius', '6px 8px 0 0', 'important');
        active.style.setProperty('padding-bottom', '12px', 'important');
        active.style.setProperty('margin-bottom', '-8px', 'important');
        active.style.setProperty('position', 'relative', 'important');
        active.style.setProperty('z-index', '10', 'important');
      }
    })();
  </script>
</body>
</html>
