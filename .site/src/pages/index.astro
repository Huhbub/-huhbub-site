---
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
---
<Base title="huhbub — creating experiences for creative people">
  <Splash />

  <div id="site">

    <!-- NAV -->
    <nav>
      <a href="/" class="nav-logo"><span class="logo-text">huhbub</span></a>
      <div class="nav-links">
        <a href="/services">services</a>
        <a href="/projects">projects</a>
        <a href="/collaborators">collaborators</a>
        <a href="/venues">venues</a>
        <a href="/about">about</a>
        <a href="/contact" class="nav-cta">get in touch</a>
      </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-overline">sara veal</p>
          <h1>
            creating<br/>
            <em>experiences</em><br/>
            for creative<br/>
            people.
          </h1>
          <p class="hero-sub">Events, environments and initiatives that bring people together, build community, and make culture happen.</p>
          <div class="hero-ctas">
            <a href="/projects" class="btn-primary">see the work</a>
            <a href="/contact" class="btn-ghost">get in touch</a>
          </div>
        </div>
        <div class="bubbles">
          <canvas id="sparkle-canvas"></canvas>

          <div class="bubble-wrap bw1" onclick="openLB('/images/hero-1.jpg','Curious Mermaid Palentines Supper Club')" aria-label="View Curious Mermaid photo">
            <div class="glow-ring"></div>
            <div class="bubble">
              <img src="/images/hero-1.jpg" alt="Curious Mermaid supper club" />
              <div class="bubble-hint">view full image</div>
            </div>
          </div>

          <div class="bubble-wrap bw2" onclick="openLB('/images/hero-2.jpg','Black to the Future · British Library')" aria-label="View Black to the Future photo">
            <div class="glow-ring"></div>
            <div class="bubble">
              <img src="/images/hero-2.jpg" alt="Black to the Future festival" />
              <div class="bubble-hint">view full image</div>
            </div>
          </div>

          <div class="bubble-wrap bw3" onclick="openLB('/images/hero-3.jpg','Happiness Workshop')" aria-label="View happiness workshop photo">
            <div class="glow-ring"></div>
            <div class="bubble">
              <img src="/images/hero-3.jpg" alt="Happiness workshop" />
              <div class="bubble-hint">view full image</div>
            </div>
          </div>
        </div>

        <!-- Lightbox -->
        <div class="lightbox" id="hero-lightbox" onclick="closeLB()">
          <div class="lb-inner" onclick="event.stopPropagation()">
            <button class="lb-close" onclick="closeLB()" aria-label="Close">×</button>
            <img id="lb-img" src="" alt="" />
            <p class="lb-caption" id="lb-caption"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-inner">
        {['event production','creative direction','people & culture','happiness workshops',
          'audience development','creative partnership','mentoring','community building',
          'cultural production','artist liaison','stage hosting','let\'s build it together',
          'event production','creative direction','people & culture','happiness workshops',
          'audience development','creative partnership','mentoring','community building',
          'cultural production','artist liaison','stage hosting','let\'s build it together'].map(t => (
          <span>{t}</span>
        ))}
      </div>
    </div>

    <!-- FEATURED PROJECT -->
    <section class="section-dark featured">
      <p class="section-label">featured project</p>
      <div class="featured-inner">
        <div class="featured-img">
          <img src="/images/featured-bttf.jpg" alt="Black to the Future festival" />
        </div>
        <div class="featured-content">
          <div class="feat-tags">
            <span class="tag tag-collab">collaborative</span>
            <span class="tag tag-self">cultural production</span>
          </div>
          <h2>Black to the Future</h2>
          <p>An Afrofuturistic festival celebrating Black excellence across the creative industries, accompanying the British Library's Fantasy: Realms of Imagination exhibition. Founded and directed by Irenosen Okojie.</p>
          <p class="feat-detail">25+ Black artists across 6 venues — British Library, Royal Society of Literature, Warner Brothers, Spotify, The Garden Cinema, The Standard Hotel, Black Cultural Archives — over 8 months, October 2023 to May 2024.</p>
          <div class="feat-pills">
            {['British Library','Warner Brothers','Spotify','25+ artists','6 venues','Oct 2023–May 2024'].map(p => (
              <span class="pill">{p}</span>
            ))}
          </div>
          <a href="/projects/black-to-the-future" class="feat-link">read the full story →</a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section-cream">
      <p class="section-label-dark">services</p>
      <h2 class="h2-dark">what I do</h2>
      <p class="sub-dark">I work with organisations, initiatives and individuals who make culture — helping them build better from the inside out.</p>

      <div class="clusters-grid">

        <div class="cluster">
          <div class="cluster-header">
            <div class="cluster-icon ci-pink">✦</div>
            <div class="cluster-title">events & production</div>
            <div class="cluster-desc">Making culture happen — in rooms, on stages, in the world.</div>
          </div>
          <div class="svc-list">
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">make culture happen</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Event production and creative direction — from concept to room. Originating, producing and directing cultural events, series and experiences that bring people together around something that matters.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">create cultural moments for good</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Social impact work that actually moves people. Translating values, causes and missions into cultural experiences. Because the best advocacy doesn't feel like advocacy.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">in the room</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Available to host, chair, speak or sit on panels. Bringing warmth, curiosity and a genuinely cross-sector perspective to stages, screens and boardrooms.</div></div>
            </div>
          </div>
        </div>

        <div class="cluster">
          <div class="cluster-header">
            <div class="cluster-icon ci-purple">❋</div>
            <div class="cluster-title">people & organisations</div>
            <div class="cluster-desc">The inside work that makes the outside work possible.</div>
          </div>
          <div class="svc-list">
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">build better environments</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">People and culture consultancy — HR infrastructure, workplace culture, community and engagement strategy for creative organisations.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">make work feel alive</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Internal events, rituals and communications that turn a workplace into a community. The culture your people experience every day, not just on special occasions.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">build something that lasts</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">For new organisations that need to get the foundations right. Brand identity, positioning, people infrastructure, internal culture — the scaffolding that lets everything else grow.</div></div>
            </div>
          </div>
        </div>

        <div class="cluster">
          <div class="cluster-header">
            <div class="cluster-icon ci-teal">◈</div>
            <div class="cluster-title">growth & connection</div>
            <div class="cluster-desc">Finding the people, building the relationships, growing the thing.</div>
          </div>
          <div class="svc-list">
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">find your people</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Audience development — helping cultural organisations and initiatives identify, reach and genuinely connect with the communities they exist to serve.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">let's build it together</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Mentoring and consultancy for people with an idea they're ready to make real. No conventional path required — just curiosity, commitment and the will to make something happen.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">creative partnership</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Being brought in as a collaborator, not a contractor. You bring the vision, huhbub brings the producing, the relationships, the judgment. Black to the Future is the model.</div></div>
            </div>
          </div>
        </div>

        <div class="cluster">
          <div class="cluster-header">
            <div class="cluster-icon ci-gold">✿</div>
            <div class="cluster-title">the happiness workshop</div>
            <div class="cluster-desc">A standalone offering. Bookable. Joyful. Transformative.</div>
          </div>
          <div class="svc-list">
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">what is it?</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">A named, bookable workshop experience for festivals, organisations, teams and individuals. Delivered at the Barbican, Primadonna Festival, Also Festival and more. Get in touch to book.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">who is it for?</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">Teams who've forgotten to have fun. Individuals at a crossroads. Festival audiences who want something that lasts beyond the weekend. Anyone who wants to think differently about joy.</div></div>
            </div>
            <div class="svc-item">
              <button class="svc-trigger">
                <span class="svc-name">what will you leave with?</span>
                <span class="svc-arrow"><svg viewBox="0 0 8 8"><path d="M1 2.5l3 3 3-3"/></svg></span>
              </button>
              <div class="svc-body"><div class="svc-inner">A clearer sense of what makes you happy — and practical tools to protect it. Not a list of tips, but a shift in how you think about joy, work, and what you're actually doing this for.</div></div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- PROJECTS -->
    <section class="section-white">
      <div class="section-header">
        <div>
          <p class="section-label-dark">projects</p>
          <h2 class="h2-dark">selected work</h2>
        </div>
        <div class="filter-bar" role="group" aria-label="Filter projects">
          <button class="filter active" data-filter="all">all</button>
          <button class="filter" data-filter="self">self-produced</button>
          <button class="filter" data-filter="commissioned">commissioned</button>
          <button class="filter" data-filter="collaborative">collaborative</button>
        </div>
      </div>
      <div class="projects-grid">
        {[
          { img:'pi1', tags:['collaborative','cultural production'], title:'Black to the Future', sub:'British Library · 2023–24', type:'collaborative' },
          { img:'pi2', tags:['self-produced','events'], title:'That Time of the Month', sub:'The Book Club, London', type:'self' },
          { img:'pi3', tags:['self-produced','cabaret'], title:'Purple Reign', sub:'Makers Academy · fundraising Code Club', type:'self' },
          { img:'pi4', tags:['self-produced','events'], title:'Curious Mermaid events', sub:'Supper club, IWD potluck · Yellow Door', type:'self' },
          { img:'pi5', tags:['collaborative','events'], title:'Strong Women Squad', sub:'Lisa Dickenson · Trapeze, London', type:'collaborative' },
          { img:'pi6', tags:['self-produced','cabaret'], title:'Feeling Noughties', sub:'Drink Shop & Do · Core Arts', type:'self' },
          { img:'pi7', tags:['commissioned','workshop'], title:'Happiness workshops', sub:'Also Festival, Primadonna, Barbican', type:'commissioned' },
          { img:'pi8', tags:['commissioned','festivals'], title:'Festival work', sub:'Larmer Tree, Port Eliot, Shambala', type:'commissioned' },
          { img:'pi9', tags:['commissioned','community'], title:'Clean Prose', sub:'70+ events · Irenosen Okojie launch', type:'commissioned' },
        ].map(p => (
          <div class={`proj-card proj-${p.type}`} data-type={p.type}>
            <div class={`proj-img ${p.img}`}><span>[ photo ]</span></div>
            <div class="proj-body">
              <div class="proj-tags">
                {p.tags.map(t => (
                  <span class={`tag tag-${t.replace(' ','-').replace('self-produced','self')}`}>{t}</span>
                ))}
              </div>
              <h3>{p.title}</h3>
              <p>{p.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- COLLABORATORS -->
    <section class="section-lavender">
      <p class="section-label-dark">collaborators</p>
      <h2 class="h2-dark">people I'm proud to work with</h2>
      <p class="sub-dark">Brilliant people I've had the pleasure of working alongside — on commissioned and self-led projects. I recommend them without hesitation.</p>
      <div class="collab-grid">
        {[
          { initials:'RL', name:'Ria Lina', role:'comedian & writer', desc:'Worked together on events bringing comedy and culture into unexpected spaces.', link:'https://rialina.com' },
          { initials:'LN', name:'Leena Norms', role:'author & content creator', desc:'Host of That Time of the Month throughout, judge at Purple Reign. A recurring joy to work with.', link:'https://leenanorms.com' },
          { initials:'SV', name:'Sanne Vliegenthart', role:'creative', desc:'A natural collaborator across events and creative projects.', link:'#' },
          { initials:'VG', name:'Viv Groskop', role:'author, comedian & speaker', desc:'Worked together on events at the intersection of culture, comedy and ideas.', link:'https://vivgroskop.com' },
        ].map(c => (
          <div class="collab-card">
            <div class="collab-photo">
              <span class="collab-initials">{c.initials}</span>
            </div>
            <div class="collab-body">
              <h3>{c.name}</h3>
              <p class="collab-role">{c.role}</p>
              <p class="collab-desc">{c.desc}</p>
              <a href={c.link} class="collab-link" target="_blank" rel="noopener">visit website →</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PERSONAL PROJECTS -->
    <section class="section-dark personal">
      <p class="section-label">personal projects</p>
      <h2>the curious mermaid universe</h2>
      <p class="sub-light">Two connected projects grown from the same spirit of curiosity, community and wonder.</p>
      <div class="personal-pair">
        <div class="pp-card">
          <span class="pp-tag">events</span>
          <h3>Curious Mermaid</h3>
          <p>Supper clubs, pop-up galleries and seasonal gatherings built around the world of Sarah Lawak's Curious Mermaid. Fundraising for Yellow Door. Where the community comes together.</p>
          <a href="/projects/curious-mermaid">see the events →</a>
        </div>
        <div class="pp-card">
          <span class="pp-tag">shop</span>
          <h3>Sirena Curiosa</h3>
          <p>An independent shop for curious people — objects, curiosities and things that spark wonder. The retail expression of the same world.</p>
          <a href="https://sirenacuriosa.com" target="_blank" rel="noopener">visit sirenacuriosa.com →</a>
        </div>
      </div>
      <p class="pp-connector">↑ two sides of the same world ↑</p>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-inner">
        <div class="footer-left">
          <p class="footer-logo">huhbub</p>
          <p class="footer-sub">huhbub ltd · sara veal · southampton · est. 2016</p>
        </div>
        <div class="footer-links">
          <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
          <a href="https://linkedin.com" target="_blank" rel="noopener">linkedin</a>
          <a href="mailto:sara@huhbub.com">email</a>
        </div>
      </div>
    </footer>

  </div><!-- #site -->
</Base>

<style>
  #site { opacity: 0; transition: opacity 0.8s ease; }
  #site.is-visible { opacity: 1; }

  /* NAV */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--sky-mid, #0E0B2E);
    border-bottom: 0.5px solid var(--border-subtle);
    padding: 16px 32px;
    display: flex; justify-content: space-between; align-items: center;
    backdrop-filter: blur(12px);
    transition: background 1s ease;
  }
  .nav-logo {
    display: flex;
    align-items: center;
  }
  .logo-text {
    font-family: var(--font-logo);
    font-size: 26px;
    font-weight: 600;
    color: var(--accent-soft, #F5A7CC);
    letter-spacing: -0.5px;
    line-height: 1;
  }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a {
    font-size: 13px; color: var(--text-secondary);
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-cta {
    border: 0.5px solid var(--border-subtle);
    padding: 7px 16px; border-radius: 20px;
    color: var(--accent-soft) !important;
    transition: background 0.2s, border-color 0.2s !important;
  }
  .nav-cta:hover { background: rgba(255,255,255,0.06); border-color: var(--accent-soft) !important; }

  /* HERO */
  .hero {
    background: var(--sky, #07051A);
    min-height: 90vh;
    display: flex; align-items: center;
    padding: 80px 16px 60px;
    transition: background 1s ease;
  }
  .hero-inner {
    max-width: 1200px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: center;
  }
  .hero-overline {
    font-size: 11px; color: var(--accent-soft);
    letter-spacing: 1.5px; text-transform: uppercase;
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 10px;
  }
  .hero-overline::before { content:''; width: 24px; height: 1px; background: var(--accent-soft); display: block; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 80px);
    font-weight: 300; line-height: 1.08;
    letter-spacing: -2px;
    color: var(--text-primary);
    margin-bottom: 24px;
  }
  h1 em { color: var(--accent-soft); font-style: italic; }
  .hero-sub {
    font-size: 15px; color: var(--text-secondary);
    line-height: 1.75; max-width: 420px; margin-bottom: 36px;
  }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--accent); color: #fff;
    font-size: 13px; font-weight: 500;
    padding: 12px 24px; border-radius: 8px;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-ghost {
    background: transparent; color: var(--text-secondary);
    font-size: 13px; padding: 12px 24px; border-radius: 8px;
    border: 0.5px solid var(--border-subtle);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--accent-soft); color: var(--text-primary); }
  /* HERO BUBBLES */
  .bubbles { position: relative; height: 500px; width: 100%; }
  #sparkle-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .bubble-wrap {
    position: absolute; cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);
    z-index: 2;
  }
  .bubble-wrap:hover { transform: scale(1.06) !important; z-index: 10; }
  .bubble-wrap:hover .bubble-hint { opacity: 1; }
  .glow-ring {
    position: absolute; border-radius: 50%; pointer-events: none; inset: -20px;
  }
  .bubble {
    position: relative; border-radius: 50%; overflow: hidden;
    width: 100%; height: 100%;
  }
  .bubble img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bubble::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 0deg, rgba(212,83,126,0.25), rgba(127,119,221,0.2), rgba(181,212,244,0.2), rgba(245,167,204,0.25), rgba(239,159,39,0.15), rgba(212,83,126,0.25));
    animation: shimmer 6s linear infinite;
    mix-blend-mode: screen; opacity: 0.6; pointer-events: none; z-index: 3;
  }
  .bubble::before {
    content: ''; position: absolute;
    width: 40%; height: 35%; top: 10%; left: 15%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(255,255,255,0.5) 0%, transparent 100%);
    z-index: 4; pointer-events: none;
  }
  .bubble-hint {
    position: absolute; inset: 0; border-radius: 50%;
    background: rgba(14,11,46,0.5);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity 0.3s; z-index: 5;
    font-size: 11px; color: #F5A7CC; letter-spacing: 1px; text-transform: uppercase;
  }
  @keyframes shimmer { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
  .bw1 { top: 0; left: 0; width: 290px; height: 290px; animation: float1 7s ease-in-out infinite; }
  .bw1 .glow-ring { background: radial-gradient(circle, rgba(212,83,126,0.28) 0%, rgba(212,83,126,0.08) 50%, transparent 70%); animation: pulse1 3s ease-in-out infinite; }
  .bw2 { top: 60px; right: 0; width: 250px; height: 250px; animation: float2 9s ease-in-out infinite; }
  .bw2 .glow-ring { background: radial-gradient(circle, rgba(127,119,221,0.28) 0%, rgba(127,119,221,0.08) 50%, transparent 70%); animation: pulse2 4s ease-in-out infinite; }
  .bw3 { bottom: 0; left: 90px; width: 210px; height: 210px; animation: float3 8s ease-in-out infinite; }
  .bw3 .glow-ring { background: radial-gradient(circle, rgba(245,167,204,0.28) 0%, rgba(239,159,39,0.08) 50%, transparent 70%); animation: pulse3 3.5s ease-in-out infinite; }
  @keyframes float1 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  @keyframes float2 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
  @keyframes float3 { 0%,100%{transform:translateY(0)} 33%{transform:translateY(-12px)} 66%{transform:translateY(-4px)} }
  @keyframes pulse1 { 0%,100%{opacity:0.7;transform:scale(1)} 50%{opacity:1;transform:scale(1.05)} }
