<script>
// Reveal site after splash exits
function revealSite() {
  const site = document.getElementById('site');
  const splash = document.getElementById('splash');
  if (!splash) { site.classList.add('is-visible'); return; }
  const observer = new MutationObserver(() => {
    if (!document.getElementById('splash')) {
      site.classList.add('is-visible');
      observer.disconnect();
    }
  });
  observer.observe(document.body, { childList: true });
}
revealSite();

// Sparkles around bubbles
(function() {
  const canvas = document.getElementById('sparkle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const container = canvas.parentElement;
  function resize() { canvas.width = container.offsetWidth; canvas.height = container.offsetHeight; }
  resize();
  const moment = window.__huhbubMoment || 'spring-night';
  const isDay = moment.includes('day');
  const COLORS = isDay
    ? ['#D4537E','#7F77DD','#EF9F27','#1D9E75','#F5A7CC','#534AB7','#E85070','#C070E0']
    : ['#F5A7CC','#D4537E','#AFA9EC','#FAC775','#B5D4F4','#ffffff'];
  const sparkles = [];
  let frame = 0;
  function getCenters() {
    return [
      {x: 145, y: 145, r: 145},
      {x: container.offsetWidth - 125, y: 185, r: 125},
      {x: 195, y: container.offsetHeight - 105, r: 105},
    ];
  }
  function spawnSparkle() {
    const centers = getCenters();
    const c = centers[Math.floor(Math.random()*centers.length)];
    const angle = Math.random()*Math.PI*2;
    const dist = c.r + Math.random()*40;
    sparkles.push({
      x: c.x + Math.cos(angle)*dist, y: c.y + Math.sin(angle)*dist,
      vx: (Math.random()-0.5)*0.4, vy: -Math.random()*0.6-0.2,
      size: isDay ? Math.random()*3.5+1.5 : Math.random()*2.5+0.5,
      col: COLORS[Math.floor(Math.random()*COLORS.length)],
      life: 0, maxLife: Math.random()*80+40,
      type: isDay ? (Math.random() < 0.4 ? 'star' : Math.random() < 0.5 ? 'rect' : 'dot') : (Math.random() < 0.5 ? 'star' : 'dot'),
    });
  }
  function drawStar(x, y, size, col, alpha) {
    ctx.save(); ctx.globalAlpha = alpha; ctx.fillStyle = col;
    ctx.translate(x, y);
    for(let i=0;i<4;i++){
      ctx.rotate(Math.PI/2); ctx.beginPath();
      ctx.moveTo(0,0); ctx.lineTo(size*0.4,size*1.2); ctx.lineTo(0,size*0.5); ctx.lineTo(-size*0.4,size*1.2);
      ctx.closePath(); ctx.fill();
    }
    ctx.restore();
  }
  function loop() {
    ctx.clearRect(0,0,canvas.width,canvas.height);
    if(frame%8===0 && sparkles.length<30) spawnSparkle();
    for(let i=sparkles.length-1;i>=0;i--){
      const s=sparkles[i]; s.life++; s.x+=s.vx; s.y+=s.vy;
      const p=s.life/s.maxLife;
      const alpha = p<0.3 ? p/0.3 : 1-((p-0.3)/0.7);
      if(s.type==='star') drawStar(s.x,s.y,s.size,s.col,alpha*0.9);
      else if(s.type==='rect') {
        ctx.save(); ctx.globalAlpha=alpha*0.85; ctx.fillStyle=s.col;
        ctx.translate(s.x,s.y); ctx.rotate(s.life*0.08);
        ctx.fillRect(-s.size,-s.size*0.5,s.size*2,s.size);
        ctx.restore();
      } else {
        ctx.save(); ctx.globalAlpha=alpha*0.7; ctx.fillStyle=s.col;
        ctx.beginPath(); ctx.arc(s.x,s.y,s.size*0.6,0,Math.PI*2); ctx.fill(); ctx.restore();
      }
      if(s.life>=s.maxLife) sparkles.splice(i,1);
    }
    frame++; requestAnimationFrame(loop);
  }
  loop();
  window.addEventListener('resize', resize);
})();

// Lightbox
window.openLB = function(src, caption) {
  const lb = document.getElementById('hero-lightbox');
  const img = document.getElementById('lb-img');
  const cap = document.getElementById('lb-caption');
  img.src = src;
  img.alt = caption;
  cap.textContent = caption;
  lb.classList.add('open');
  document.body.style.overflow = 'hidden';
}
window.closeLB = function() {
  document.getElementById('hero-lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeLB(); });

// Services cluster expand/collapse
document.querySelectorAll('.svc-trigger').forEach(btn => {
  btn.addEventListener('click', () => {
    const body = btn.nextElementSibling;
    const isOpen = btn.classList.contains('open');
    document.querySelectorAll('.svc-trigger.open').forEach(b => {
      b.classList.remove('open');
      b.nextElementSibling.classList.remove('open');
    });
    if (!isOpen) {
      btn.classList.add('open');
      body.classList.add('open');
      burstEffect(btn);
    }
  });
});

function burstEffect(el) {
  const rect = el.getBoundingClientRect();
  const cx = rect.right - 18;
  const cy = rect.top + rect.height / 2;
  const colors = ['#D4537E','#F5A7CC','#EF9F27','#7F77DD','#FAC775','#AFA9EC'];
  const container = document.createElement('div');
  container.className = 'burst';
  container.style.left = cx + 'px';
  container.style.top = cy + 'px';
  document.body.appendChild(container);
  for (let i = 0; i < 10; i++) {
    const dot = document.createElement('div');
    dot.className = 'burst-dot';
    const angle = (i / 10) * Math.PI * 2;
    const dist = 24 + Math.random() * 20;
    dot.style.setProperty('--tx', Math.cos(angle) * dist + 'px');
    dot.style.setProperty('--ty', Math.sin(angle) * dist + 'px');
    dot.style.background = colors[i % colors.length];
    dot.style.animationDelay = (Math.random() * 0.08) + 's';
    container.appendChild(dot);
  }
  setTimeout(() => container.remove(), 800);
}
// Polaroid flip — hover on desktop, tap on mobile
document.querySelectorAll('.flip-wrap').forEach(w => {
  w.addEventListener('mouseenter', () => {
    if(window.innerWidth > 768) w.classList.add('flipped');
  });
  w.addEventListener('mouseleave', () => {
    if(window.innerWidth > 768) w.classList.remove('flipped');
  });
  w.addEventListener('click', () => {
    if(window.innerWidth <= 768) w.classList.toggle('flipped');
  });
});

// Project filter
document.querySelectorAll('.filter').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const f = btn.dataset.filter;
    document.querySelectorAll('.flip-wrap').forEach(card => {
      card.classList.toggle('hidden', f !== 'all' && card.dataset.type !== f);
    });
  });
});
</script>
