---
import Base from '../layouts/Base.astro';
---
<Base title="Sara Veal">
<div id="site">

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo nav-link"><span class="logo-text">huhbub</span></a>
    <div class="nav-links">
      <a href="/services" class="nav-link">services</a>
      <a href="/projects" class="nav-link">projects</a>
      <a href="/events" class="nav-link">events</a>
      <a href="/about" class="nav-link">about</a>
      <a href="/stories" class="nav-link">stories</a>
      <a href="/contact" class="nav-link nav-cta">contact</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="menu-close">×</button>
    <div class="mobile-menu-links">
      <a href="/services" onclick="closeMenu()">services</a>
      <a href="/projects" onclick="closeMenu()">projects</a>
      <a href="/events" onclick="closeMenu()">events</a>
      <a href="/about" onclick="closeMenu()">about</a>
      <a href="/stories" onclick="closeMenu()">stories</a>
      <a href="mailto:sara@huhbub.com" onclick="closeMenu()">contact</a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="sara-page">
    <canvas id="float-canvas"></canvas>
    <div class="sara-inner">
      <div class="sara-portrait">
        <div class="portrait-frame">
          <img src="/images/sara-portrait.jpg" alt="Sara Veal" onerror="this.parentElement.classList.add('no-img')" />
          <div class="portrait-placeholder">SV</div>
        </div>
      </div>
      <div class="sara-content">
        <p class="sara-overline">founder & digital witch</p>
        <h1>Sara Veal</h1>
        <p class="sara-lead">Producer. Community builder. People strategist. Writer. Founder of huhbub. Based in Southampton.</p>
        <p class="sara-body">A full portfolio — career, projects, writing, and everything in between — is coming soon.</p>
        <p class="sara-body">In the meantime, the best place to find out what I do is <a href="/about">huhbub.com/about</a>, and the best way to reach me is <a href="mailto:sara@huhbub.com">sara@huhbub.com</a>.</p>
        <div class="sara-links">
          <a href="/about" class="nav-link btn-primary">about huhbub →</a>
          <a href="https://linkedin.com/in/sara-veal-37557715b" target="_blank" rel="noopener" class="btn-secondary">linkedin →</a>
          <a href="https://thecuriousmermaid.substack.com" target="_blank" rel="noopener" class="btn-secondary">the curious mermaid →</a>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-logo">huhbub</p>
        <p class="footer-sub">huhbub ltd · sara veal · southampton · est. 2016</p>
      </div>
      <div class="footer-links">
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <a href="https://linkedin.com/in/sara-veal-37557715b" target="_blank" rel="noopener">linkedin</a>
        <a href="/press" class="nav-link">press</a>
          <a href="mailto:sara@huhbub.com">email</a>
      </div>
    </div>
  </footer>
</div>
</Base>

<style>
.nav-links a:hover { color: #fff !important; text-shadow: 0 0 10px rgba(245,167,204,0.7), 0 0 20px rgba(245,167,204,0.3); }
nav { position: sticky; top: 0; z-index: 100; background: var(--sky-mid, #0E0B2E); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); transition: background 1s; }
  .nav-logo { display: flex; align-items: center; }
  .logo-text { font-family: var(--font-logo); font-size: 26px; font-weight: 600; color: var(--accent-soft, #F5A7CC); letter-spacing: -0.5px; line-height: 1; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); transition: color 0.2s; }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--accent-soft, #F5A7CC); border-radius: 2px; }
  .mobile-menu { position: fixed; inset: 0; background: var(--sky-mid, #0E0B2E); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-menu-close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: var(--accent-soft); font-size: 32px; cursor: pointer; }
  .mobile-menu-links { display: flex; flex-direction: column; align-items: center; }
  .mobile-menu-links a { font-family: var(--font-display); font-size: 36px; font-weight: 300; color: var(--text-primary); padding: 8px 0; transition: color 0.2s; }
  .mobile-menu-links a:hover { color: var(--accent-soft); }

  /* SARA PAGE */
  .sara-page { position: relative; min-height: calc(100vh - 58px - 80px); background: var(--sky, #07051A); display: flex; align-items: center; justify-content: center; padding: 64px 32px; overflow: hidden; transition: background 1s; }
  #float-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.5; }
  .sara-inner { position: relative; z-index: 2; max-width: 860px; margin: 0 auto; display: grid; grid-template-columns: 240px 1fr; gap: 64px; align-items: center; }
  .portrait-frame { width: 200px; height: 260px; position: relative; overflow: hidden; border-radius: 2px; box-shadow: 4px 6px 24px rgba(0,0,0,0.5); border: 6px solid #fff; }
  .portrait-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .portrait-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #1A0A2E, #0E0B2E); font-family: var(--font-display); font-size: 48px; font-weight: 300; color: rgba(245,167,204,0.35); }
  .portrait-frame.no-img img { display: none; }
  .sara-overline { font-size: 11px; color: var(--accent-soft); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .sara-overline::before { content: ''; width: 24px; height: 1px; background: var(--accent-soft); display: block; }
  h1 { font-family: var(--font-display); font-size: clamp(40px, 6vw, 72px); font-weight: 300; color: var(--text-primary); letter-spacing: -2px; line-height: 1; margin-bottom: 20px; }
  .sara-lead { font-size: 16px; color: var(--text-primary); line-height: 1.7; margin-bottom: 12px; max-width: 500px; }
  .sara-body { font-size: 14px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 10px; max-width: 500px; }
  .sara-body a { color: var(--accent-soft); border-bottom: 0.5px solid rgba(245,167,204,0.3); transition: border-color 0.2s; }
  .sara-body a:hover { border-color: var(--accent-soft); }
  .sara-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .btn-primary { font-size: 13px !important; font-weight: 500; color: #fff !important; background: var(--accent, #D4537E); padding: 10px 20px; border-radius: 8px; transition: opacity 0.2s; }
  .btn-primary:hover { opacity: 0.85; }
  .btn-secondary { font-size: 13px; color: var(--text-secondary); border: 0.5px solid var(--border-subtle); padding: 10px 20px; border-radius: 8px; transition: all 0.2s; }
  .btn-secondary:hover { color: var(--text-primary); background: rgba(255,255,255,0.04); }

  footer { background: #070520; padding: 32px; border-top: 0.5px solid rgba(255,255,255,0.06); }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .footer-logo { font-family: var(--font-display); font-size: 20px; font-weight: 300; color: #534AB7; margin-bottom: 4px; }
  .footer-sub { font-size: 12px; color: #3C3489; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { font-size: 13px; color: #7F77DD; transition: color 0.2s; }
  .footer-links a:hover { color: var(--accent-soft); }

  @media (max-width: 768px) {
    .nav-links { display: none; } .nav-burger { display: flex; }
    .sara-inner { grid-template-columns: 1fr; gap: 32px; text-align: center; }
    .sara-portrait { display: flex; justify-content: center; }
    .sara-overline { justify-content: center; }
    .sara-overline::before { display: none; }
    h1 { letter-spacing: -1px; }
    .sara-links { justify-content: center; }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

  // Gentle floating particles
  (function() {
    const canvas = document.getElementById('float-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const COLORS = ['#D4537E','#F5A7CC','#AFA9EC','#FAC775','#7F77DD'];
    let W, H;
    function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
    resize(); window.addEventListener('resize', resize);
    const ps = Array.from({length: 24}, () => ({
      x: Math.random() * 800, y: Math.random() * 600,
      r: Math.random() * 3 + 1, vx: (Math.random()-.5)*.35, vy: -Math.random()*.3-.1,
      col: COLORS[Math.floor(Math.random()*COLORS.length)],
      phase: Math.random()*Math.PI*2, alpha: Math.random()*.35+.1,
    }));
    function anim() {
      ctx.clearRect(0,0,W,H);
      ps.forEach(p => {
        p.x+=p.vx; p.y+=p.vy; p.phase+=0.018;
        if(p.y<-10){p.y=H+10;p.x=Math.random()*W;}
        if(p.x<-10)p.x=W+10; if(p.x>W+10)p.x=-10;
        const tw=0.6+0.4*Math.sin(p.phase);
        const grd=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*2.5);
        grd.addColorStop(0,p.col);grd.addColorStop(1,'rgba(0,0,0,0)');
        ctx.save();
        ctx.globalAlpha=p.alpha*tw*.4;ctx.fillStyle=grd;
        ctx.beginPath();ctx.arc(p.x,p.y,p.r*2.5,0,Math.PI*2);ctx.fill();
        ctx.globalAlpha=p.alpha*tw;ctx.fillStyle=p.col;
        ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
        ctx.restore();
      });
      requestAnimationFrame(anim);
    }
    anim();
  })();

</script>
