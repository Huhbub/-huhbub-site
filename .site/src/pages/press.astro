---
import Base from '../layouts/Base.astro';

const press = [
  {
    publication: 'GamesIndustry.biz',
    headline: "Sara Veal's framework for a more sustainable and supportive games industry",
    url: 'https://www.gamesindustry.biz/sara-veals-framework-for-a-more-sustainable-and-supportive-games-industry',
    date: '2024',
    projectSlug: '',
    tags: ['games industry', 'people strategy'],
    type: 'link',
  },
  {
    publication: 'The Bookseller',
    headline: 'Discomfort creates great events',
    url: 'https://www.thebookseller.com/comment/discomfort-creates-great-events',
    date: '2019',
    projectSlug: '',
    tags: ['events', 'opinion'],
    type: 'link',
  },
  {
    publication: 'The Guardian',
    headline: 'The British Library celebrates the surge in popularity of fantasy fiction',
    url: 'https://www.theguardian.com/books/2023/oct/27/the-british-library-celebrates-the-surge-in-popularity-of-fantasy-fiction-london',
    date: 'October 2023',
    projectSlug: 'black-to-the-future',
    tags: ['Black to the Future', 'fantasy fiction'],
    type: 'link',
  },
  {
    publication: 'The Bookseller',
    headline: 'Clean Prose hosts edible book launch for Irenosen Okojie',
    url: 'https://www.thebookseller.com/news/clean-prose-hosts-edible-book-launch-irenosen-okojie-1122701',
    date: '2019',
    projectSlug: 'clean-prose',
    tags: ['Clean Prose', 'Irenosen Okojie'],
    type: 'link',
  },
];

const pubColors: Record<string, string> = {
  'The Guardian': '#D4537E',
  'The Bookseller': '#7F77DD',
  'GamesIndustry.biz': '#EF9F27',
  'default': '#AFA9EC',
};
---

<Base title="press — huhbub">
<div id="site">
  <div id="teleport-overlay"></div>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo nav-link"><span class="logo-text">huhbub</span></a>
    <div class="nav-links">
      <a href="/services" class="nav-link">services</a>
      <a href="/projects" class="nav-link">projects</a>
      <a href="/events" class="nav-link">events</a>
      <a href="/about" class="nav-link">about</a>
      <a href="/stories" class="nav-link">stories</a>
      <a href="mailto:sara@huhbub.com" class="nav-cta">contact</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="menu-close">×</button>
    <div class="mobile-menu-links">
      <a href="/services" onclick="closeMenu()">services</a>
      <a href="/projects" onclick="closeMenu()">projects</a>
      <a href="/events" onclick="closeMenu()">events</a>
      <a href="/about" onclick="closeMenu()">about</a>
      <a href="/stories" onclick="closeMenu()">stories</a>
      <a href="mailto:sara@huhbub.com" onclick="closeMenu()">contact</a>
    </div>
  </div>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-overline">press</p>
      <h1>huhbub in the world</h1>
      <p class="page-sub">Coverage, features and mentions across publications. A partial record — more to come.</p>
    </div>
  </div>

  <!-- PRESS LIST -->
  <div class="press-section">
    <div class="press-inner">
      {press.map((item, i) => (
        <div class="press-item" style={`--delay: ${i * 0.06}s`}>
          <div class="press-pub" style={`color: ${pubColors[item.publication] || pubColors['default']}`}>
            {item.publication}
          </div>
          <div class="press-main">
            {item.type === 'link' ? (
              <a href={item.url} target="_blank" rel="noopener" class="press-headline">
                {item.headline}
              </a>
            ) : (
              <span class="press-headline press-clipping">{item.headline}</span>
            )}
            <div class="press-meta">
              <span class="press-date">{item.date}</span>
              {item.projectSlug && (
                <a href={`/projects/${item.projectSlug}`} class="press-project nav-link">↗ {item.tags[0]}</a>
              )}
            </div>
          </div>
          <div class="press-action">
            {item.type === 'link' ? (
              <a href={item.url} target="_blank" rel="noopener" class="press-read">read →</a>
            ) : (
              <span class="press-clipping-label">clipping</span>
            )}
          </div>
        </div>
      ))}

      <p class="press-note">More coverage being gathered — comprehensive list coming soon.</p>
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-logo">huhbub</p>
        <p class="footer-sub">huhbub ltd · sara veal · southampton · est. 2016</p>
      </div>
      <div class="footer-middle">
        <p class="footer-subscribe-label">read The Curious Mermaid</p>
        <a href="https://thecuriousmermaid.substack.com" target="_blank" rel="noopener" class="btn-subscribe-footer">subscribe on substack →</a>
      </div>
      <div class="footer-links">
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <a href="https://linkedin.com/in/sara-veal-37557715b" target="_blank" rel="noopener">linkedin</a>
        <a href="mailto:sara@huhbub.com">email</a>
      </div>
    </div>
  </footer>

</div>
</Base>

<style>
  #site { opacity: 0; transition: opacity 0.6s ease; }
  #site.is-visible { opacity: 1; }
  /* NAV GLOW */
  .nav-links a { position: relative; }
  .nav-links a::after { content: ''; position: absolute; inset: -4px -8px; border-radius: 6px; background: radial-gradient(ellipse at center, rgba(245,167,204,0.18) 0%, transparent 70%); opacity: 0; pointer-events: none; transition: opacity 0.35s; }
  .nav-links a:hover::after { opacity: 1; }
  .nav-links a:hover { color: #fff !important; text-shadow: 0 0 10px rgba(245,167,204,0.7), 0 0 20px rgba(245,167,204,0.3); }
  /* TELEPORT */
  #teleport-overlay { position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0; background: radial-gradient(ellipse 60% 60% at var(--ox,50%) var(--oy,10%), rgba(255,255,255,0.98) 0%, rgba(245,167,204,0.85) 18%, rgba(175,169,236,0.7) 40%, rgba(212,83,126,0.4) 65%, transparent 85%); }

  nav { position: sticky; top: 0; z-index: 100; background: var(--sky-mid, #0E0B2E); border-bottom: 0.5px solid var(--border-subtle); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); transition: background 1s; }
  .nav-logo { display: flex; align-items: center; }
  .logo-text { font-family: var(--font-logo); font-size: 26px; font-weight: 600; color: var(--accent-soft, #F5A7CC); letter-spacing: -0.5px; line-height: 1; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); transition: color 0.2s; }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-cta { border: 0.5px solid var(--border-subtle); padding: 7px 16px; border-radius: 20px; color: var(--accent-soft) !important; }
  .nav-cta:hover { background: rgba(255,255,255,0.06); }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--accent-soft, #F5A7CC); border-radius: 2px; }
  .mobile-menu { position: fixed; inset: 0; background: var(--sky-mid, #0E0B2E); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-menu-close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: var(--accent-soft); font-size: 32px; cursor: pointer; }
  .mobile-menu-links { display: flex; flex-direction: column; align-items: center; }
  .mobile-menu-links a { font-family: var(--font-display); font-size: 36px; font-weight: 300; color: var(--text-primary); padding: 8px 0; transition: color 0.2s; }
  .mobile-menu-links a:hover { color: var(--accent-soft); }

  .page-hero { background: var(--sky, #07051A); padding: 48px 32px 40px; border-bottom: 0.5px solid var(--border-subtle); transition: background 1s; }
  .page-hero-inner { max-width: 960px; margin: 0 auto; }
  .page-overline { font-size: 11px; color: var(--accent-soft); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .page-overline::before { content: ''; width: 24px; height: 1px; background: var(--accent-soft); display: block; }
  h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 62px); font-weight: 300; color: var(--text-primary); line-height: 1.05; letter-spacing: -2px; margin-bottom: 14px; }
  .page-sub { font-size: 15px; color: var(--text-secondary); line-height: 1.7; max-width: 520px; }

  /* PRESS LIST */
  .press-section { background: var(--sky, #07051A); padding: 48px 32px 64px; transition: background 1s; }
  .press-inner { max-width: 960px; margin: 0 auto; border-top: 0.5px solid var(--border-subtle); }

  .press-item {
    display: grid;
    grid-template-columns: 160px 1fr 80px;
    gap: 24px; align-items: center;
    padding: 20px 0;
    border-bottom: 0.5px solid rgba(255,255,255,0.05);
    animation: fadeIn 0.4s ease backwards;
    animation-delay: var(--delay);
    transition: background 0.15s;
  }
  .press-item:hover { background: rgba(255,255,255,0.02); margin: 0 -8px; padding-left: 8px; padding-right: 8px; }
  @keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

  .press-pub {
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.8px; text-transform: uppercase;
  }

  .press-headline {
    display: block;
    font-family: var(--font-display);
    font-size: 18px; font-weight: 300;
    color: var(--text-primary);
    letter-spacing: -0.2px;
    line-height: 1.3;
    margin-bottom: 6px;
    transition: color 0.2s;
  }
  a.press-headline:hover { color: var(--accent-soft); }

  .press-meta { display: flex; gap: 16px; align-items: center; }
  .press-date { font-size: 11px; color: var(--text-secondary); }
  .press-project { font-size: 11px; color: var(--accent-soft); opacity: 0.7; transition: opacity 0.2s; }
  .press-project:hover { opacity: 1; }

  .press-read {
    font-size: 12px; color: var(--text-secondary);
    transition: color 0.2s; text-align: right; display: block;
  }
  .press-read:hover { color: var(--accent-soft); }
  .press-clipping-label {
    font-size: 10px; color: rgba(255,255,255,0.2);
    letter-spacing: 1px; text-transform: uppercase;
    text-align: right; display: block;
  }

  .press-note { font-size: 12px; color: rgba(255,255,255,0.2); margin-top: 40px; font-style: italic; }

  footer { background: #070520; padding: 32px; border-top: 0.5px solid rgba(255,255,255,0.06); }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .footer-logo { font-family: var(--font-display); font-size: 20px; font-weight: 300; color: #534AB7; margin-bottom: 4px; }
  .footer-sub { font-size: 12px; color: #3C3489; }
  .footer-middle { text-align: center; }
  .footer-subscribe-label { font-size: 11px; color: #534AB7; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .btn-subscribe-footer { font-size: 13px; font-weight: 500; color: #fff; background: #534AB7; padding: 9px 18px; border-radius: 8px; transition: opacity 0.2s; display: inline-block; }
  .btn-subscribe-footer:hover { opacity: 0.85; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { font-size: 13px; color: #7F77DD; transition: color 0.2s; }
  .footer-links a:hover { color: var(--accent-soft); }

  @media (max-width: 768px) {
    .nav-links { display: none; } .nav-burger { display: flex; }
    h1 { letter-spacing: -1px; }
    .press-item { grid-template-columns: 1fr; gap: 8px; }
    .press-action { display: none; }
  }
</style>

<script>
  document.getElementById('site').classList.add('is-visible');
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

  const MOMENT_COLORS = {
    'spring-dawn':['#F5A7CC','#FAC775','#AFA9EC','#F4C0D1'],'spring-day':['#D4537E','#7F77DD','#F5A7CC','#EF9F27'],
    'spring-dusk':['#F5A7CC','#EF9F27','#7F77DD','#FAC775'],'spring-night':['#D4537E','#AFA9EC','#FAC775','#F5A7CC'],
    'summer-dawn':['#FAC775','#EF9F27','#F5A7CC','#FAEEDA'],'summer-day':['#EF9F27','#D4537E','#FAC775','#F5A7CC'],
    'summer-dusk':['#D4537E','#FAC775','#AFA9EC','#F5A7CC'],'summer-night':['#FAC775','#7F77DD','#F5A7CC','#EF9F27'],
    'autumn-dawn':['#EF9F27','#D85A30','#FAC775','#BA7517'],'autumn-day':['#BA7517','#D85A30','#EF9F27','#FAC775'],
    'autumn-dusk':['#EF9F27','#D4537E','#7F77DD','#D85A30'],'autumn-night':['#EF9F27','#D85A30','#AFA9EC','#FAC775'],
    'winter-dawn':['#B5D4F4','#85B7EB','#F5A7CC','#AFA9EC'],'winter-day':['#378ADD','#7F77DD','#F5A7CC','#B5D4F4'],
    'winter-dusk':['#AFA9EC','#F5A7CC','#B5D4F4','#7F77DD'],'winter-night':['#7F77DD','#B5D4F4','#F5A7CC','#AFA9EC'],
  };
  function sparkleTo(href,ox,oy){
    const canvas=document.getElementById('sparkle-canvas'),ctx=canvas.getContext('2d');
    canvas.width=window.innerWidth;canvas.height=window.innerHeight;canvas.classList.add('active');
    const palette=MOMENT_COLORS[window.__huhbubMoment||'spring-night'];
    const ps=[];
    for(let i=0;i<48;i++){const a=Math.random()*Math.PI*2,s=Math.random()*5+1.5;ps.push({x:ox,y:oy,vx:Math.cos(a)*s,vy:Math.sin(a)*s,r:Math.random()*5+2,col:palette[Math.floor(Math.random()*palette.length)],alpha:0,phase:Math.random()*Math.PI*2});}
    setTimeout(()=>{window.location.href=href;},420);
    let frame=0;const TOTAL=36;
    function anim(){if(frame>TOTAL)return;ctx.clearRect(0,0,canvas.width,canvas.height);ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vx*=0.96;p.vy*=0.96;const tw=0.7+0.3*Math.sin(p.phase+frame*0.25);const fi=8,fo=TOTAL-fi;const base=frame<fi?frame/fi:1-((frame-fi)/fo);p.alpha=Math.max(0,base*tw);if(p.alpha<=0)return;const grd=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*2.5);grd.addColorStop(0,p.col);grd.addColorStop(1,'rgba(0,0,0,0)');ctx.save();ctx.globalAlpha=p.alpha*0.35;ctx.fillStyle=grd;ctx.beginPath();ctx.arc(p.x,p.y,p.r*2.5,0,Math.PI*2);ctx.fill();ctx.globalAlpha=p.alpha;ctx.fillStyle=p.col;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();ctx.restore();});frame++;requestAnimationFrame(anim);}
    anim();
  }
  document.querySelectorAll('.nav-link').forEach(a=>{a.addEventListener('click',e=>{const href=a.getAttribute('href');if(!href||href.startsWith('mailto')||href.startsWith('http'))return;e.preventDefault();const rect=a.getBoundingClientRect();sparkleTo(href,rect.left+rect.width/2,rect.top+rect.height/2);});});
</script>
