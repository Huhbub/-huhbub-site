---
import Base from '../layouts/Base.astro';
import Splash from '../components/Splash.astro';
---
<Base title="huhbub — something's coming">
  <Splash />

  <div id="site">
    <canvas id="bg-canvas"></canvas>

    <div class="content">
      <div class="logo-wrap">
        <span class="logo-text">huhbub</span>
      </div>

      <div class="main">
        <p class="overline">sara veal · southampton</p>
        <h1>creating <em>experiences</em><br/>for creative people.</h1>
        <p class="sub">Something is being made. In the meantime, get in touch.</p>
        <a href="mailto:sara@huhbub.com" class="cta">sara@huhbub.com</a>
      </div>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-inner">
          {['intimate events','supper clubs','conferences & festivals','happiness workshops',
            'cabaret','panel curation','audience development','community building',
            'cultural production','artist liaison','stage hosting','new initiatives',
            'intimate events','supper clubs','conferences & festivals','happiness workshops',
            'cabaret','panel curation','audience development','community building',
            'cultural production','artist liaison','stage hosting','new initiatives',
          ].map(t => <span>{t}</span>)}
        </div>
      </div>

      <footer>
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <span>·</span>
        <a href="mailto:sara@huhbub.com">email</a>
      </footer>
    </div>
  </div>
</Base>

<style>
  #site {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  #site.is-visible { opacity: 1; }

  #bg-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 48px;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
  }

  .logo-text {
    font-family: 'Nunito', system-ui, sans-serif;
    font-size: 28px;
    font-weight: 600;
    color: var(--accent-soft, #F5A7CC);
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .main {
    max-width: 640px;
    padding: 0;
  }

  .overline {
    font-size: 12px;
    color: var(--accent-soft, #F5A7CC);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .overline::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--accent-soft, #F5A7CC);
    display: block;
    flex-shrink: 0;
  }

  h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(48px, 8vw, 88px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -2px;
    color: var(--text-primary, #F5F0FF);
    margin-bottom: 28px;
  }

  h1 em {
    color: var(--accent-soft, #F5A7CC);
    font-style: italic;
  }

  .sub {
    font-size: 16px;
    color: var(--text-secondary, #9B96CC);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 420px;
  }

  .cta {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary, #F5F0FF);
    border-bottom: 1px solid var(--accent-soft, #F5A7CC);
    padding-bottom: 3px;
    letter-spacing: 0.3px;
    transition: color 0.2s, border-color 0.2s;
  }
  .cta:hover {
    color: var(--accent-soft, #F5A7CC);
  }

  .marquee {
    overflow: hidden;
    white-space: nowrap;
    border-top: 0.5px solid rgba(255,255,255,0.08);
    border-bottom: 0.5px solid rgba(255,255,255,0.08);
    padding: 10px 0;
    margin: 0 -48px;
  }
  .marquee-inner {
    display: inline-block;
    animation: marquee 32s linear infinite;
  }
  .marquee-inner span {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-secondary, #9B96CC);
    margin: 0 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .marquee-inner span:nth-child(even) { opacity: 0.4; }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  footer {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
  }
  footer a {
    font-size: 13px;
    color: var(--text-secondary, #9B96CC);
    transition: color 0.2s;
  }
  footer a:hover { color: var(--accent-soft, #F5A7CC); }
  footer span { color: var(--text-secondary, #9B96CC); opacity: 0.4; }

  @media (max-width: 600px) {
    .content { padding: 28px 24px; }
    .marquee { margin: 0 -24px; }
    h1 { letter-spacing: -1px; }
  }
</style>

<script>
  // Reveal after splash
  function revealSite() {
    const site = document.getElementById('site');
    const splash = document.getElementById('splash');
    if (!splash) { site.classList.add('is-visible'); return; }
    const observer = new MutationObserver(() => {
      if (!document.getElementById('splash')) {
        site.classList.add('is-visible');
        observer.disconnect();
      }
    });
    observer.observe(document.body, { childList: true });
  }
  revealSite();

  // Ambient background canvas — gentle drifting particles
  (function() {
    const canvas = document.getElementById('bg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const moment = window.__huhbubMoment || 'spring-night';
    const palettes = {
      'spring-dawn':['#F5A7CC','#FAC775','#AFA9EC'],
      'spring-day':['#D4537E','#7F77DD','#1D9E75'],
      'spring-dusk':['#F5A7CC','#EF9F27','#7F77DD'],
      'spring-night':['#D4537E','#AFA9EC','#FAC775'],
      'summer-dawn':['#FAC775','#EF9F27','#F5A7CC'],
      'summer-day':['#EF9F27','#D4537E','#1D9E75'],
      'summer-dusk':['#D4537E','#FAC775','#AFA9EC'],
      'summer-night':['#FAC775','#7F77DD','#F5A7CC'],
      'autumn-dawn':['#EF9F27','#D85A30','#FAC775'],
      'autumn-day':['#BA7517','#D85A30','#EF9F27'],
      'autumn-dusk':['#EF9F27','#D4537E','#7F77DD'],
      'autumn-night':['#EF9F27','#D85A30','#AFA9EC'],
      'winter-dawn':['#B5D4F4','#85B7EB','#F5A7CC'],
      'winter-day':['#378ADD','#7F77DD','#F5A7CC'],
      'winter-dusk':['#AFA9EC','#F5A7CC','#B5D4F4'],
      'winter-night':['#7F77DD','#B5D4F4','#F5A7CC'],
    };
    const colors = palettes[moment] || palettes['spring-night'];
    let W, H, objs = [], fr = 0;

    function resize() {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    }
    function rand(a, b) { return a + Math.random() * (b - a); }

    function spawn(init = false) {
      return {
        x: rand(0.02, 0.98) * W,
        y: init ? rand(0, 1) * H : H + 20,
        vx: rand(-0.18, 0.18),
        vy: rand(-0.35, -0.1),
        r: rand(6, 18),
        col: colors[Math.floor(Math.random() * colors.length)],
        born: fr,
        life: rand(400, 800),
        phase: Math.random() * Math.PI * 2,
      };
    }

    function draw(o) {
      const age = fr - o.born;
      const fi = Math.min(1, age / 60);
      const fo = age > o.life - 80 ? Math.max(0, (o.life - age) / 80) : 1;
      const a = fi * fo * 0.55;
      if (a <= 0.01) return;
      const pulse = 0.6 + 0.4 * Math.sin(o.phase + fr * 0.03);
      ctx.save();
      ctx.globalAlpha = a;
      const gr = ctx.createRadialGradient(o.x, o.y, 0, o.x, o.y, o.r * 2.5 * pulse);
      gr.addColorStop(0, o.col + 'cc');
      gr.addColorStop(1, o.col + '00');
      ctx.fillStyle = gr;
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r * 2.5 * pulse, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = a * 0.8;
      ctx.fillStyle = o.col;
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r * 0.4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function loop() {
      ctx.clearRect(0, 0, W, H);
      if (fr % 45 === 0 && objs.length < 20) objs.push(spawn(false));
      objs = objs.filter(o => fr - o.born < o.life);
      objs.forEach(o => { o.x += o.vx; o.y += o.vy; draw(o); });
      fr++;
      requestAnimationFrame(loop);
    }

    resize();
    for (let i = 0; i < 12; i++) {
      const o = spawn(true);
      o.born = fr - Math.floor(rand(30, 300));
      objs.push(o);
    }
    loop();
    window.addEventListener('resize', resize);
  })();
</script>
