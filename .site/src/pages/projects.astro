---
import Base from '../layouts/Base.astro';

const projects = [
  { slug:'black-to-the-future', title:'Black to the Future', year:'2023', type:'collaborative', tags:['festival','afrofuturism','curation'], caption:'afrofuturism at the British Library', description:'A ground-breaking Afrofuturist festival at the British Library. huhbub produced and creatively directed; Irenosen Okojie founded and led artistically.', image:'/images/project-bttf.jpg', poster:'/images/poster-bttf.jpg', rot:-2 },
  { slug:'clean-prose', title:'Clean Prose', year:'2016–2020', type:'commissioned', tags:['literary events','books','community'], caption:'Created and promoted launch programme for London’s first literary co-working space', description:'Over 70 literary events produced for Clean Prose, including an edible book launch for Irenosen Okojie's Nudibranch.', image:'/images/project-clean-prose.jpg', poster:'/images/poster-clean-prose.jpg', rot:1.5 },
  { slug:'that-time-of-the-month', title:'That Time of the Month', year:'2018–2019', type:'self', tags:['book club','jane austen','community'], caption:'Jane Austen, feminist readings, feelings', description:'A feminist book club and screening series bringing women together around Jane Austen — with wine, feelings, and zero irony.', image:'/images/project-that-time.jpg', poster:'/images/poster-that-time.jpg', rot:-1 },
  { slug:'strong-women-squad', title:'Strong Women Squad', year:'2018', type:'self', tags:['community','wellbeing','events'], caption:'sisterhood in east London', description:'A community of women and non-binary people making space for strength, softness and solidarity — parties, panels and everything in between.', image:'/images/project-strong-women.jpg', poster:'/images/poster-strong-women.jpg', rot:2 },
  { slug:'purple-reign', title:'Purple Reign', year:'2018', type:'self', tags:['music','cabaret','celebration'], caption:'a Prince-inspired birthday bakeoff cabaret', description:'A vegan birthday bakeoff cabaret in tribute to Prince. One night, one legend, many cakes.', image:'/images/project-purple-reign.jpg', poster:'/images/poster-purple-reign.jpg', rot:-2.5 },
  { slug:'feeling-noughties', title:'Feeling Noughties', year:'2016', type:'self', tags:['music','nostalgia','party'], caption:'noughties nostalgia at Drink Shop & Do', description:'A Y2K nostalgia party celebrating the music, fashion and chaos of the 2000s. Sold out. Obviously.', image:'/images/project-feeling-noughties.jpg', poster:'/images/poster-feeling-noughties.jpg', rot:1 },
  { slug:'happiness-workshop', title:'The Happiness Workshop', year:'2019–present', type:'self', tags:['wellbeing','workshop','facilitation'], caption:'joy as a practice, not a destination', description:'A standalone workshop on the science and art of happiness. Delivered at the Barbican, Primadonna, Also Festival, Logging Off Club and more.', image:'/images/project-happiness.jpg', poster:'/images/poster-happiness.jpg', rot:-1.5 },
  { slug:'curious-mermaid', title:'The Curious Mermaid', year:'2024–present', type:'self', tags:['writing','community','substack'], caption:'stories of creativity, community & belonging', description:'An essay series and community newsletter exploring creativity, community and the beauty in what others might overlook.', image:'/images/project-curious-mermaid.jpg', poster:'/images/poster-curious-mermaid.jpg', rot:2.5 },
];

const typeLabel = { self: 'self-produced', commissioned: 'commissioned', collaborative: 'collaborative' };
const typeColor = { self: '#D4537E', commissioned: '#EF9F27', collaborative: '#7F77DD' };
---

<Base title="projects — huhbub">
<div id="site">
  <canvas id="sparkle-canvas"></canvas>

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo nav-link"><span class="logo-text">huhbub</span></a>
    <div class="nav-links">
      <a href="/services" class="nav-link">services</a>
      <a href="/projects" class="nav-link active">projects</a>
      <a href="/collaborators" class="nav-link">collaborators</a>
      <a href="/venues" class="nav-link">venues</a>
      <a href="/writing" class="nav-link">writing</a>
      <a href="/about" class="nav-link">about</a>
      <a href="mailto:sara@huhbub.com" class="nav-cta">get in touch</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="menu-close">×</button>
    <div class="mobile-menu-links">
      <a href="/services" onclick="closeMenu()">services</a>
      <a href="/projects" onclick="closeMenu()">projects</a>
      <a href="/collaborators" onclick="closeMenu()">collaborators</a>
      <a href="/venues" onclick="closeMenu()">venues</a>
      <a href="/writing" onclick="closeMenu()">writing</a>
      <a href="/about" onclick="closeMenu()">about</a>
      <a href="mailto:sara@huhbub.com" onclick="closeMenu()">get in touch</a>
    </div>
  </div>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-overline">projects</p>
      <h1>a decade of making things happen</h1>
      <p class="page-sub">Events, series, festivals and cultural experiences — self-produced, commissioned, and in creative partnership. Hover to flip.</p>
      <div class="filter-pills">
        <button class="filter-pill active" data-filter="all">all</button>
        <button class="filter-pill" data-filter="self">self-produced</button>
        <button class="filter-pill" data-filter="commissioned">commissioned</button>
        <button class="filter-pill" data-filter="collaborative">collaborative</button>
      </div>
    </div>
  </div>

  <!-- CORKBOARD -->
  <div class="corkboard">
    <div class="corkboard-texture"></div>
    <div class="polaroids-grid" id="polaroids-grid">
      {projects.map((p, i) => (
        <div
          class="polaroid-wrap"
          data-type={p.type}
          style={`--rot: ${p.rot}deg; --delay: ${i * 0.07}s`}
        >
          <!-- PIN -->
          <div class="pin"></div>

          <div class="polaroid">
            <!-- FRONT: poster -->
            <div class="polaroid-front">
              <div class="polaroid-img">
                <img src={p.poster} alt={p.title} loading="lazy" onerror="this.parentElement.classList.add('no-img')" />
                <div class="polaroid-img-placeholder">
                  <span class="placeholder-initial">{p.title[0]}</span>
                </div>
              </div>
              <div class="polaroid-label">
                <span class="polaroid-caption">{p.caption}</span>
                <span class="polaroid-year">{p.year}</span>
              </div>
            </div>

            <!-- BACK: info -->
            <div class="polaroid-back">
              <div class="back-type" style={`color: ${typeColor[p.type]}`}>{typeLabel[p.type]}</div>
              <h3 class="back-title">{p.title}</h3>
              <p class="back-desc">{p.description}</p>
              <div class="back-tags">
                {p.tags.map(t => <span class="back-tag">{t}</span>)}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-logo">huhbub</p>
        <p class="footer-sub">huhbub ltd · sara veal · southampton · est. 2016</p>
      </div>
      <div class="footer-middle">
        <p class="footer-subscribe-label">read The Curious Mermaid</p>
        <a href="https://curiousmermaid.substack.com" target="_blank" rel="noopener" class="btn-subscribe-footer">subscribe on substack →</a>
      </div>
      <div class="footer-links">
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener">linkedin</a>
        <a href="mailto:sara@huhbub.com">email</a>
      </div>
    </div>
  </footer>

</div>
</Base>

<style>
  #site { opacity: 0; transition: opacity 0.6s ease; }
  #site.is-visible { opacity: 1; }

  /* SPARKLE */
  #sparkle-canvas { position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0; width: 100%; height: 100%; }
  #sparkle-canvas.active { opacity: 1; pointer-events: all; }

  /* NAV */
  nav { position: sticky; top: 0; z-index: 100; background: var(--sky-mid, #0E0B2E); border-bottom: 0.5px solid var(--border-subtle); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); transition: background 1s; }
  .nav-logo { display: flex; align-items: center; }
  .logo-text { font-family: var(--font-logo); font-size: 26px; font-weight: 600; color: var(--accent-soft, #F5A7CC); letter-spacing: -0.5px; line-height: 1; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); transition: color 0.2s; }
  .nav-links a:hover, .nav-links a.active { color: var(--text-primary); }
  .nav-links a.active { border-bottom: 1px solid var(--accent-soft); padding-bottom: 1px; }
  .nav-cta { border: 0.5px solid var(--border-subtle); padding: 7px 16px; border-radius: 20px; color: var(--accent-soft) !important; }
  .nav-cta:hover { background: rgba(255,255,255,0.06); }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--accent-soft, #F5A7CC); border-radius: 2px; }

  /* MOBILE MENU */
  .mobile-menu { position: fixed; inset: 0; background: var(--sky-mid, #0E0B2E); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-menu-close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: var(--accent-soft); font-size: 32px; cursor: pointer; }
  .mobile-menu-links { display: flex; flex-direction: column; align-items: center; gap: 0; }
  .mobile-menu-links a { font-family: var(--font-display); font-size: 36px; font-weight: 300; color: var(--text-primary); padding: 8px 0; transition: color 0.2s; }
  .mobile-menu-links a:hover { color: var(--accent-soft); }

  /* PAGE HERO */
  .page-hero { background: var(--sky, #07051A); padding: 48px 32px 36px; border-bottom: 0.5px solid var(--border-subtle); transition: background 1s; }
  .page-hero-inner { max-width: 960px; margin: 0 auto; }
  .page-overline { font-size: 11px; color: var(--accent-soft); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .page-overline::before { content: ''; width: 24px; height: 1px; background: var(--accent-soft); display: block; }
  h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 60px); font-weight: 300; color: var(--text-primary); line-height: 1.05; letter-spacing: -2px; margin-bottom: 14px; }
  .page-sub { font-size: 15px; color: var(--text-secondary); line-height: 1.7; max-width: 520px; margin-bottom: 28px; }

  /* FILTER PILLS */
  .filter-pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .filter-pill { font-size: 12px; color: var(--text-secondary); padding: 6px 16px; border-radius: 20px; border: 0.5px solid rgba(255,255,255,0.12); background: transparent; cursor: pointer; transition: all 0.2s; font-family: var(--font-body); }
  .filter-pill.active { background: var(--accent, #D4537E); color: #fff; border-color: var(--accent, #D4537E); }
  .filter-pill:hover:not(.active) { background: rgba(255,255,255,0.06); color: var(--text-primary); }

  /* CORKBOARD */
  .corkboard {
    position: relative;
    background: #8B6914;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.03) 3px, rgba(0,0,0,0.03) 4px),
      repeating-linear-gradient(90deg, transparent, transparent 3px, rgba(0,0,0,0.03) 3px, rgba(0,0,0,0.03) 4px);
    min-height: 600px;
    padding: 60px 40px 80px;
    border-top: 6px solid #6B4F10;
    border-bottom: 6px solid #6B4F10;
    box-shadow: inset 0 4px 20px rgba(0,0,0,0.3), inset 0 -4px 20px rgba(0,0,0,0.2);
  }

  .polaroids-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 24px;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* POLAROID WRAP */
  .polaroid-wrap {
    position: relative;
    transform: rotate(var(--rot));
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
    animation: polaroid-drop 0.5s ease backwards;
    animation-delay: var(--delay);
  }
  .polaroid-wrap.hidden { opacity: 0; pointer-events: none; transform: rotate(var(--rot)) scale(0.9); }
  @keyframes polaroid-drop {
    from { opacity: 0; transform: rotate(var(--rot)) translateY(-20px); }
    to   { opacity: 1; transform: rotate(var(--rot)) translateY(0); }
  }
  .polaroid-wrap:hover { transform: rotate(0deg) scale(1.04); z-index: 10; }

  /* PIN */
  .pin {
    position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
    width: 14px; height: 14px; border-radius: 50%; z-index: 5;
    background: radial-gradient(circle at 35% 35%, #F5A7CC, #D4537E);
    box-shadow: 0 2px 6px rgba(0,0,0,0.4), inset 0 1px 2px rgba(255,255,255,0.3);
  }
  .polaroid-wrap:nth-child(2n) .pin { background: radial-gradient(circle at 35% 35%, #FAC775, #EF9F27); }
  .polaroid-wrap:nth-child(3n) .pin { background: radial-gradient(circle at 35% 35%, #AFA9EC, #7F77DD); }
  .polaroid-wrap:nth-child(4n) .pin { background: radial-gradient(circle at 35% 35%, #B5D4F4, #378ADD); }

  /* POLAROID CARD — 3D flip */
  .polaroid {
    width: 200px;
    background: #fff;
    padding: 10px 10px 32px;
    box-shadow: 3px 4px 14px rgba(0,0,0,0.28), 0 1px 4px rgba(0,0,0,0.15);
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
  }
  .polaroid-wrap:hover .polaroid { transform: rotateY(180deg); }

  .polaroid-front,
  .polaroid-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* FRONT */
  .polaroid-front { position: relative; }
  .polaroid-img {
    width: 100%; height: 180px;
    background: #E8E0D8; overflow: hidden; position: relative;
  }
  .polaroid-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .polaroid-img-placeholder {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #E8D8C8, #D0C0B0);
    opacity: 1;
  }
  .polaroid-img img + .polaroid-img-placeholder { opacity: 0; }
  .polaroid-img.no-img img { display: none; }
  .polaroid-img.no-img .polaroid-img-placeholder { opacity: 1; }
  .placeholder-initial {
    font-family: var(--font-display); font-size: 56px; font-weight: 300;
    color: rgba(80,60,40,0.3); line-height: 1;
  }
  .polaroid-label { padding: 8px 2px 0; }
  .polaroid-caption {
    display: block; font-family: var(--font-handwriting, 'Caveat', cursive);
    font-size: 14px; color: #3A2E22; line-height: 1.3;
  }
  .polaroid-year {
    display: block; font-size: 10px; color: #8A7A6A;
    margin-top: 2px; letter-spacing: 0.5px;
  }

  /* BACK */
  .polaroid-back {
    position: absolute; inset: 0;
    background: #FFF8F0; padding: 16px 14px;
    transform: rotateY(180deg);
    display: flex; flex-direction: column; justify-content: center;
    border: 0.5px solid #E0D4C8;
  }
  .back-type {
    font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase;
    font-weight: 600; margin-bottom: 8px;
  }
  .back-title {
    font-family: var(--font-display); font-size: 16px; font-weight: 400;
    color: #2A1E14; line-height: 1.2; margin-bottom: 8px; letter-spacing: -0.2px;
  }
  .back-desc {
    font-size: 11px; color: #6A5A4A; line-height: 1.6; margin-bottom: 10px;
    flex: 1;
  }
  .back-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .back-tag {
    font-size: 9px; color: #8A7060; background: #EDE4D8;
    padding: 2px 7px; border-radius: 10px; letter-spacing: 0.3px;
  }

  /* FOOTER */
  footer { background: #070520; padding: 32px; border-top: 0.5px solid rgba(255,255,255,0.06); }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .footer-logo { font-family: var(--font-display); font-size: 20px; font-weight: 300; color: #534AB7; margin-bottom: 4px; }
  .footer-sub { font-size: 12px; color: #3C3489; }
  .footer-middle { text-align: center; }
  .footer-subscribe-label { font-size: 11px; color: #534AB7; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .btn-subscribe-footer { font-size: 13px; font-weight: 500; color: #fff; background: #534AB7; padding: 9px 18px; border-radius: 8px; transition: opacity 0.2s; display: inline-block; }
  .btn-subscribe-footer:hover { opacity: 0.85; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { font-size: 13px; color: #7F77DD; transition: color 0.2s; }
  .footer-links a:hover { color: var(--accent-soft); }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-burger { display: flex; }
    .polaroid { width: 160px; }
    .polaroid-img { height: 140px; }
    .corkboard { padding: 40px 20px 60px; }
    .polaroids-grid { gap: 24px 16px; }
    h1 { letter-spacing: -1px; }
  }
</style>

<script>
  document.getElementById('site').classList.add('is-visible');

  // Mobile menu
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

  // Filter
  document.querySelectorAll('.filter-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      document.querySelectorAll('.polaroid-wrap').forEach(card => {
        const show = filter === 'all' || card.dataset.type === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });

  // Nav sparkle transition
  const MOMENT_COLORS = {
    'spring-dawn':['#F5A7CC','#FAC775','#AFA9EC','#F4C0D1'],'spring-day':['#D4537E','#7F77DD','#F5A7CC','#EF9F27'],
    'spring-dusk':['#F5A7CC','#EF9F27','#7F77DD','#FAC775'],'spring-night':['#D4537E','#AFA9EC','#FAC775','#F5A7CC'],
    'summer-dawn':['#FAC775','#EF9F27','#F5A7CC','#FAEEDA'],'summer-day':['#EF9F27','#D4537E','#FAC775','#F5A7CC'],
    'summer-dusk':['#D4537E','#FAC775','#AFA9EC','#F5A7CC'],'summer-night':['#FAC775','#7F77DD','#F5A7CC','#EF9F27'],
    'autumn-dawn':['#EF9F27','#D85A30','#FAC775','#BA7517'],'autumn-day':['#BA7517','#D85A30','#EF9F27','#FAC775'],
    'autumn-dusk':['#EF9F27','#D4537E','#7F77DD','#D85A30'],'autumn-night':['#EF9F27','#D85A30','#AFA9EC','#FAC775'],
    'winter-dawn':['#B5D4F4','#85B7EB','#F5A7CC','#AFA9EC'],'winter-day':['#378ADD','#7F77DD','#F5A7CC','#B5D4F4'],
    'winter-dusk':['#AFA9EC','#F5A7CC','#B5D4F4','#7F77DD'],'winter-night':['#7F77DD','#B5D4F4','#F5A7CC','#AFA9EC'],
  };

  function sparkleTo(href, ox, oy) {
    const canvas = document.getElementById('sparkle-canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth; canvas.height = window.innerHeight;
    canvas.classList.add('active');
    const palette = MOMENT_COLORS[window.__huhbubMoment||'spring-night'];
    const ps = [];
    for(let i=0;i<48;i++){
      const angle=Math.random()*Math.PI*2, speed=Math.random()*5+1.5;
      ps.push({x:ox,y:oy,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,
        r:Math.random()*5+2,col:palette[Math.floor(Math.random()*palette.length)],
        alpha:0,phase:Math.random()*Math.PI*2});
    }
    setTimeout(()=>{window.location.href=href;},420);
    let frame=0;const TOTAL=36;
    function anim(){
      if(frame>TOTAL)return;
      ctx.clearRect(0,0,canvas.width,canvas.height);
      ps.forEach(p=>{
        p.x+=p.vx;p.y+=p.vy;p.vx*=0.96;p.vy*=0.96;
        const tw=0.7+0.3*Math.sin(p.phase+frame*0.25);
        const fi=8,fo=TOTAL-fi;
        const base=frame<fi?frame/fi:1-((frame-fi)/fo);
        p.alpha=Math.max(0,base*tw);
        if(p.alpha<=0)return;
        const grd=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*2.5);
        grd.addColorStop(0,p.col);grd.addColorStop(1,'rgba(0,0,0,0)');
        ctx.save();ctx.globalAlpha=p.alpha*0.35;ctx.fillStyle=grd;
        ctx.beginPath();ctx.arc(p.x,p.y,p.r*2.5,0,Math.PI*2);ctx.fill();
        ctx.globalAlpha=p.alpha;ctx.fillStyle=p.col;
        ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
        ctx.restore();
      });
      frame++;requestAnimationFrame(anim);
    }
    anim();
  }

  document.querySelectorAll('.nav-link').forEach(a => {
    a.addEventListener('click', e => {
      const href = a.getAttribute('href');
      if (!href || href.startsWith('mailto') || href.startsWith('http')) return;
      e.preventDefault();
      const rect = a.getBoundingClientRect();
      sparkleTo(href, rect.left + rect.width/2, rect.top + rect.height/2);
    });
  });
</script>
