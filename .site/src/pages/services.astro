<script>
  // Reveal
  function revealSite() {
    const site = document.getElementById('site');
    const splash = document.getElementById('splash');
    if (!splash) { site.classList.add('is-visible'); return; }
    const observer = new MutationObserver(() => {
      if (!document.getElementById('splash')) { site.classList.add('is-visible'); observer.disconnect(); }
    });
    observer.observe(document.body, { childList: true });
  }
  revealSite();
  // Mobile menu
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

  // Origami heart — open/close
  const origamiCluster = document.getElementById('origami-cluster');
  const origamiToggle = document.getElementById('origami-toggle');
  const origamiClose = document.getElementById('origami-close');
  origamiToggle?.addEventListener('click', e => {
    if (e.target.closest('.origami-open')) return; // clicks inside open card don't toggle
    origamiCluster.classList.toggle('is-open');
  });
  origamiClose?.addEventListener('click', e => {
    e.stopPropagation();
    origamiCluster.classList.remove('is-open');
  });

  // Services expand/collapse with burst
  document.querySelectorAll('.svc-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling;
      const isOpen = btn.classList.contains('open');
      document.querySelectorAll('.svc-trigger.open').forEach(b => { b.classList.remove('open'); b.nextElementSibling.classList.remove('open'); });
      if (!isOpen) { btn.classList.add('open'); body.classList.add('open'); burstEffect(btn); }
    });
  });

  function burstEffect(el) {
    const rect = el.getBoundingClientRect();
    const colors = ['#D4537E','#F5A7CC','#EF9F27','#7F77DD','#FAC775','#AFA9EC'];
    const container = document.createElement('div');
    container.className = 'burst';
    container.style.cssText = `left:${rect.right-18}px;top:${rect.top+rect.height/2}px`;
    document.body.appendChild(container);
    for (let i = 0; i < 10; i++) {
      const dot = document.createElement('div');
      dot.className = 'burst-dot';
      const angle = (i/10)*Math.PI*2, dist = 22+Math.random()*18;
      dot.style.setProperty('--tx', Math.cos(angle)*dist+'px');
      dot.style.setProperty('--ty', Math.sin(angle)*dist+'px');
      dot.style.background = colors[i%colors.length];
      dot.style.animationDelay = (Math.random()*0.08)+'s';
      container.appendChild(dot);
    }
    setTimeout(() => container.remove(), 800);
  }

</script>
