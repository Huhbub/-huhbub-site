---
import Base from '../layouts/Base.astro';
---
<Base title="uh oh — huhbub">
<div id="site">

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo nav-link"><span class="logo-text">huhbub</span></a>
    <div class="nav-links">
      <a href="/services" class="nav-link">services</a>
      <a href="/projects" class="nav-link">projects</a>
      <a href="/events" class="nav-link">events</a>
      <a href="/about" class="nav-link">about</a>
      <a href="/stories" class="nav-link">stories</a>
      <a href="/contact" class="nav-link nav-cta">contact</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="menu-close">×</button>
    <div class="mobile-menu-links">
      <a href="/services" onclick="closeMenu()">services</a>
      <a href="/projects" onclick="closeMenu()">projects</a>
      <a href="/events" onclick="closeMenu()">events</a>
      <a href="/about" onclick="closeMenu()">about</a>
      <a href="/stories" onclick="closeMenu()">stories</a>
      <a href="mailto:hello@huhbub.com" onclick="closeMenu()">contact</a>
    </div>
  </div>

  <!-- 404 CONTENT -->
  <div class="not-found">
    <canvas id="float-canvas"></canvas>
    <div class="not-found-inner">
      <p class="error-code">404</p>
      <h1>uh oh — you've time-travelled<br/>to a future that doesn't exist yet.</h1>
      <p class="error-sub">This page is still being made. It'll be here soon — huhbub turns 10 in July 2026 and the full site is on its way.</p>
      <div class="error-links">
        <a href="/" class="nav-link btn-home">← back to huhbub</a>
        <a href="/projects" class="nav-link btn-ghost">see the work</a>
        <a href="mailto:hello@huhbub.com" class="btn-ghost">get in touch</a>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-logo">huhbub</p>
        <p class="footer-sub">huhbub ltd · sara veal · est. 2016</p>
        <p class="footer-address">The Design Chapel · Cemetery Rd · Southampton · SO15 7AF</p>
      </div>
      <div class="footer-links">
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <a href="https://linkedin.com/in/sara-veal-37557715b" target="_blank" rel="noopener">linkedin</a>
        <a href="/press" class="nav-link">press</a>
          <a href="mailto:hello@huhbub.com">email</a>
      </div>
    </div>
  </footer>
</div>
</Base>

<style>
.nav-links a:hover { color: #fff !important; text-shadow: 0 0 10px rgba(245,167,204,0.7), 0 0 20px rgba(245,167,204,0.3); }
nav { position: sticky; top: 0; z-index: 100; background: var(--sky-mid, #0E0B2E); padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px);  }
  .nav-logo { display: flex; align-items: center; }
  .logo-text { font-family: var(--font-logo); font-size: 26px; font-weight: 600; color: var(--accent-soft, #F5A7CC); letter-spacing: -0.5px; line-height: 1; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); transition: color 0.2s; }
  .nav-links a:hover { color: #1E1040; }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--accent-soft, #F5A7CC); border-radius: 2px; }
  .mobile-menu { position: fixed; inset: 0; background: var(--sky-mid, #0E0B2E); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-menu-close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: var(--accent-soft); font-size: 32px; cursor: pointer; }
  .mobile-menu-links { display: flex; flex-direction: column; align-items: center; }
  .mobile-menu-links a { font-family: var(--font-display); font-size: 36px; font-weight: 300; color: #1E1040; padding: 8px 0; transition: color 0.2s; }
  .mobile-menu-links a:hover { color: var(--accent-soft); }
  .not-found { position: relative; min-height: calc(100vh - 58px - 80px); background: var(--sky, #07051A); display: flex; align-items: center; justify-content: center; padding: 64px 32px; overflow: hidden;  }
  #float-canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.6; }
  .not-found-inner { position: relative; z-index: 2; text-align: center; max-width: 640px; }
  .error-code { font-family: var(--font-display); font-size: clamp(80px, 15vw, 160px); font-weight: 300; color: rgba(212,83,126,0.12); line-height: 1; letter-spacing: -6px; margin-bottom: -16px; user-select: none; }
  h1 { font-family: var(--font-display); font-size: clamp(24px, 4vw, 40px); font-weight: 300; color: #1E1040; line-height: 1.15; letter-spacing: -1px; margin-bottom: 20px; }
  .error-sub { font-size: 15px; color: var(--text-secondary); line-height: 1.75; margin-bottom: 36px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .error-links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .btn-home { font-size: 14px !important; font-weight: 500; color: #fff !important; background: var(--accent, #D4537E); padding: 12px 24px; border-radius: 8px; transition: opacity 0.2s; }
  .btn-home:hover { opacity: 0.85; }
  .btn-ghost { font-size: 14px; color: var(--text-secondary) !important; border: 0.5px solid var(--border-subtle); padding: 12px 24px; border-radius: 8px; transition: all 0.2s; }
  .btn-ghost:hover { color: #1E1040 !important; background: rgba(255,255,255,0.04); }
  footer { background: #070520; padding: 32px; border-top: 0.5px solid rgba(255,255,255,0.06); }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .footer-logo { font-family: var(--font-display); font-size: 20px; font-weight: 300; color: #AFA9EC; margin-bottom: 4px; }
  .footer-sub { font-size: 12px; color: #AFA9EC; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { font-size: 13px; color: #AFA9EC; transition: color 0.2s; }
  .footer-links a:hover { color: #fff; }
  @media (max-width: 768px) { .nav-links { display: none; } .nav-burger { display: flex; } h1 { letter-spacing: -0.5px; } .error-links { flex-direction: column; align-items: center; } }
</style>

<script>
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

  // Floating particles
  (function() {
    const canvas = document.getElementById('float-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const COLORS = ['#D4537E','#F5A7CC','#AFA9EC','#FAC775','#7F77DD','#EF9F27'];
    let W, H, frame = 0;
    function resize() { W = canvas.width = canvas.offsetWidth; H = canvas.height = canvas.offsetHeight; }
    resize(); window.addEventListener('resize', resize);
    const particles = Array.from({length: 28}, () => ({
      x: Math.random() * 800, y: Math.random() * 600,
      r: Math.random() * 3 + 1,
      vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4 - 0.2,
      col: COLORS[Math.floor(Math.random() * COLORS.length)],
      phase: Math.random() * Math.PI * 2,
      alpha: Math.random() * 0.4 + 0.15,
    }));
    function anim() {
      ctx.clearRect(0, 0, W, H);
      particles.forEach(p => {
        p.x += p.vx; p.y += p.vy; p.phase += 0.018;
        if (p.y < -10) { p.y = H + 10; p.x = Math.random() * W; }
        if (p.x < -10) p.x = W + 10; if (p.x > W + 10) p.x = -10;
        const tw = 0.6 + 0.4 * Math.sin(p.phase);
        const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 2.5);
        grd.addColorStop(0, p.col); grd.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.save();
        ctx.globalAlpha = p.alpha * tw * 0.4; ctx.fillStyle = grd;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 2.5, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = p.alpha * tw; ctx.fillStyle = p.col;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
      });
      frame++; requestAnimationFrame(anim);
    }
    anim();
  })();

</script>
