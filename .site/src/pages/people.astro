---
import Base from '../layouts/Base.astro';

const collaborators = [
  {
    slug: 'ria-lina',
    name: 'Ria Lina',
    role: 'comedian, writer & performer',
    pronouns: 'she/her',
    bio: 'Ria Lina is a Filipina-Irish comedian, writer and performer whose work spans stand-up, TV and theatre. Sharp, warm and politically astute, she brings a perspective that is entirely her own. huhbub has worked with Ria across multiple events exploring identity, culture and what it means to belong.',
    link: 'https://rialina.co.uk',
    linkLabel: 'rialina.co.uk',
    img: '/images/collab-ria-lina.jpg',
    size: 'large',
  },
  {
    slug: 'leena-norms',
    name: 'Leena Norms',
    role: 'author, YouTuber & presenter',
    pronouns: 'she/her',
    bio: 'Leena Norms is an author, YouTuber and presenter known for thoughtful, generous content on books, culture and mental health. Her ability to make people feel genuinely seen is something huhbub has always admired and built on in collaboration.',
    link: 'https://leenanorms.com',
    linkLabel: 'leenanorms.com',
    img: '/images/collab-leena-norms.jpg',
    size: 'medium',
  },
  {
    slug: 'sanne-vliegenthart',
    name: 'Sanne Vliegenthart',
    role: 'author & content creator',
    pronouns: 'she/her',
    bio: 'Sanne Vliegenthart is a Dutch author and content creator based in the UK. Her warmth and genuine enthusiasm for books and community make her a natural fit for the huhbub way of doing things.',
    link: 'https://instagram.com/sannexreads',
    linkLabel: '@sannexreads',
    img: '/images/collab-sanne-vliegenthart.jpg',
    size: 'medium',
  },
  {
    slug: 'viv-groskop',
    name: 'Viv Groskop',
    role: 'author, comedian & broadcaster',
    pronouns: 'she/her',
    bio: 'Viv Groskop is an author, comedian and broadcaster. Her work on confidence, speaking up and how women navigate ambition has been a natural fit with the huhbub ethos — and her rooms are always alive.',
    link: 'https://vivgroskop.com',
    linkLabel: 'vivgroskop.com',
    img: '/images/collab-viv-groskop.jpg',
    size: 'large',
  },
  {
    slug: 'irenosen-okojie',
    name: 'Irenosen Okojie',
    role: 'author & artistic director',
    pronouns: 'she/her',
    bio: 'Irenosen Okojie is an award-winning author and the artistic director of Black to the Future. Her writing is dazzling, her vision is singular, and her friendship and creative partnership has been one of the great privileges of huhbub\'s work.',
    link: 'https://irenosenokojie.com',
    linkLabel: 'irenosenokojie.com',
    img: '/images/collab-irenosen-okojie.jpg',
    size: 'large',
  },
  {
    slug: 'sarah-lawak',
    name: 'Sarah LaWak',
    role: 'illustrator & artist',
    pronouns: 'she/her',
    bio: 'Sarah LaWak is an illustrator and artist whose work is full of magic and myth. She created the original vision of The Curious Mermaid — paper and paint, a purple frame — and the results stunned everyone who saw them.',
    link: '',
    linkLabel: '',
    img: '/images/collab-sarah-lawak.jpg',
    size: 'small',
  },
];

const rotations = [-2, 1.5, -1, 2.5, -1.5, 1];
---

<Base title="people huhbub has worked with — huhbub">
<div id="site">

  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo nav-link"><span class="logo-text">huhbub</span></a>
    <div class="nav-links">      <a href="/about" class="nav-link">about</a>
      <a href="/services" class="nav-link">services</a>
      <a href="/projects" class="nav-link">projects</a>
      <a href="/events" class="nav-link">events</a>
      <a href="/stories" class="nav-link">stories</a>
      <a href="/contact" class="nav-link nav-cta">contact</a>
    </div>
    <button class="nav-burger" id="burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="menu-close">×</button>
    <div class="mobile-menu-links">      <a href="/about" onclick="closeMenu()">about</a>
      <a href="/services" onclick="closeMenu()">services</a>
      <a href="/projects" onclick="closeMenu()">projects</a>
      <a href="/events" onclick="closeMenu()">events</a>
      <a href="/stories" onclick="closeMenu()">stories</a>
      <a href="/stories" onclick="closeMenu()">stories</a>
      <a href="mailto:hello@huhbub.com" onclick="closeMenu()">contact</a>
    </div>
  </div>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-inner">
      <p class="page-overline">people</p>
      <h1>who we make things with</h1>
      <p class="page-sub">huhbub works best in company. These are some of the brilliant people who've brought their talent, voice and vision to make things happen together.</p>
    </div>
  </div>

  <!-- GALLERY WALL -->
  <div class="gallery-wall">
    <div class="wall-texture"></div>
    <div class="frames-container">
      {collaborators.map((c, i) => (
        <div
          class={`frame-wrap size-${c.size}`}
          style={`--rot: ${rotations[i % rotations.length]}deg; --delay: ${i * 0.1}s`}
          data-slug={c.slug}
        >
          <!-- HANGING WIRE -->
          <div class="frame-wire"></div>

          <div class="frame">
            <!-- PORTRAIT -->
            <div class="frame-portrait">
              <img src={c.img} alt={c.name} loading="lazy" onerror="this.parentElement.classList.add('no-img')" />
              <div class="portrait-fallback">
                {c.name.split(' ').map((n: string) => n[0]).join('')}
              </div>
            </div>

            <!-- NAME PLATE -->
            <div class="frame-nameplate">
              <span class="nameplate-name">{c.name}</span>
            </div>

            <!-- BIO OVERLAY — appears on hover -->
            <div class="frame-bio">
              <div class="bio-inner">
                <p class="bio-role">{c.role}</p>
                <h3 class="bio-name">{c.name}</h3>
                <p class="bio-text">{c.bio}</p>
                {c.link && (
                  <a href={c.link} target="_blank" rel="noopener" class="bio-link" onclick="event.stopPropagation()">{c.linkLabel} →</a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- WORK TOGETHER CTA -->
  <div class="collab-cta">
    <div class="cta-inner">
      <h2>want to make something together?</h2>
      <p>huhbub is always interested in the right creative partnerships. Get in touch.</p>
      <a href="mailto:hello@huhbub.com" class="btn-cta">hello@huhbub.com</a>
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-logo">huhbub</p>
        <p class="footer-sub">huhbub ltd · sara veal · est. 2016</p>
        <p class="footer-address">The Design Chapel, Cemetery Rd, Southampton SO15 7AF</p>
        <p class="footer-credit">site built with Astro by huhbub</p>
      </div>
      <div class="footer-middle">
        <p class="footer-subscribe-label">read the curious mermaid</p>
        <a href="https://thecuriousmermaid.substack.com" target="_blank" rel="noopener" class="btn-subscribe-footer">subscribe on substack →</a>
      </div>
      <div class="footer-links">
        <a href="https://instagram.com/huhbubltd" target="_blank" rel="noopener">instagram</a>
        <a href="https://linkedin.com/in/sara-veal-37557715b" target="_blank" rel="noopener">linkedin</a>
        <a href="/press" class="nav-link">press</a>
        <a href="mailto:hello@huhbub.com">email</a>
      </div>
    </div>
  </footer>

</div>
</Base>

<style>
.nav-links a:hover { color: #fff !important; text-shadow: 0 0 10px rgba(245,167,204,0.7), 0 0 20px rgba(245,167,204,0.3); }
/* NAV */
  nav { position: sticky; top: 0; z-index: 100; background: var(--sky-mid, #0E0B2E); padding: 16px 32px 0 32px; display: flex; justify-content: space-between; align-items: center; box-shadow: none;  }
  .nav-logo { display: flex; align-items: center; }
  .logo-text { font-family: var(--font-logo); font-size: 26px; font-weight: 600; color: var(--accent-soft, #F5A7CC); letter-spacing: -0.5px; line-height: 1; }
  .nav-links { display: flex; gap: 24px; align-items: center; }
  .nav-links a { font-size: 13px; color: var(--text-secondary); transition: color 0.2s; }
  .nav-links a:hover { color: #D4D0F0; }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav-burger span { display: block; width: 22px; height: 2px; background: var(--accent-soft, #F5A7CC); border-radius: 2px; }
  .mobile-menu { position: fixed; inset: 0; background: var(--sky-mid, #0E0B2E); z-index: 200; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-menu-close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: var(--accent-soft); font-size: 32px; cursor: pointer; }
  .mobile-menu-links { display: flex; flex-direction: column; align-items: center; }
  .mobile-menu-links a { font-family: var(--font-display); font-size: 36px; font-weight: 300; color: #D4D0F0; padding: 8px 0; transition: color 0.2s; }
  .mobile-menu-links a:hover { color: var(--accent-soft); }

  /* PAGE HERO */
  .page-hero { background: #E8829A; margin-top: -4px; padding: 48px 32px 40px; border-bottom: 0.5px solid var(--border-subtle);  }
  .page-hero-inner { max-width: 960px; margin: 0 auto; }
  .page-overline { font-size: 11px; color: rgba(30,16,64,0.65); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .page-overline::before { content: ''; width: 24px; height: 1.5px; background: rgba(30,16,64,0.45); display: inline-block; margin-right: 10px; vertical-align: middle; flex-shrink: 0; }
  h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 62px); font-weight: 300; color: #1E1040; line-height: 1.05; letter-spacing: -2px; margin-bottom: 14px; }
  .page-sub { font-size: 15px; color: #2A1040; line-height: 1.7; max-width: 520px; }

  /* GALLERY WALL */
  .gallery-wall {
    position: relative;
    background: #1C1208;
    background-image:
      repeating-linear-gradient(0deg, transparent, transparent 40px, rgba(255,255,255,0.012) 40px, rgba(255,255,255,0.012) 41px),
      repeating-linear-gradient(90deg, transparent, transparent 40px, rgba(255,255,255,0.012) 40px, rgba(255,255,255,0.012) 41px);
    padding: 80px 40px 100px;
    min-height: 500px;
    border-top: 6px solid #0E0906;
    border-bottom: 6px solid #0E0906;
    box-shadow: inset 0 4px 32px rgba(0,0,0,0.5), inset 0 -4px 32px rgba(0,0,0,0.3);
  }

  .frames-container {
    display: flex;
    flex-wrap: wrap;
    gap: 72px 48px;
    justify-content: center;
    align-items: flex-end;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* FRAME WRAP */
  .frame-wrap {
    position: relative;
    transform: rotate(var(--rot));
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), z-index 0s;
    animation: frame-drop 0.6s ease backwards;
    animation-delay: var(--delay);
    cursor: pointer;
  }
  @keyframes frame-drop {
    from { opacity: 0; transform: rotate(var(--rot)) translateY(-30px); }
    to   { opacity: 1; transform: rotate(var(--rot)) translateY(0); }
  }
  .frame-wrap:hover { transform: rotate(0deg) scale(1.04); z-index: 20; }

  /* SIZES */
  .size-large  .frame { width: 200px; min-height: 220px; }
  .size-medium .frame { width: 160px; min-height: 178px; }
  .size-small  .frame { width: 130px; min-height: 146px; }
  .size-large  .frame-portrait { aspect-ratio: 1; height: auto; }
  .size-medium .frame-portrait { aspect-ratio: 1; height: auto; }
  .size-small  .frame-portrait { aspect-ratio: 1; height: auto; }

  /* HANGING WIRE */
  .frame-wire {
    position: absolute;
    top: -28px; left: 50%;
    transform: translateX(-50%);
    width: 1px; height: 28px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.15), rgba(255,255,255,0.08));
  }
  .frame-wire::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 5px; height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    box-shadow: 0 0 4px rgba(255,255,255,0.1);
  }

  /* FRAME */
  .frame {
    position: relative;
    background: #F8F2EC;
    padding: 8px 8px 0;
    box-shadow:
      0 0 0 1px rgba(0,0,0,0.3),
      0 0 0 3px #C8A876,
      0 0 0 4px rgba(0,0,0,0.2),
      4px 8px 20px rgba(0,0,0,0.5);
    overflow: hidden;
  }

  /* Frame gilt detail */
  .frame::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 0.5px solid rgba(255,215,100,0.2);
    pointer-events: none;
    z-index: 5;
  }

  /* PORTRAIT */
  .frame-portrait {
    width: 100%;
    background: linear-gradient(135deg, #2A1848, #0E0B2E);
    overflow: hidden;
    position: relative;
  }
  .frame-portrait img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s;
    filter: sepia(8%) contrast(1.05);
    position: relative; z-index: 1;
  }
  .frame-wrap:hover .frame-portrait img { transform: scale(1.04); }
  .portrait-fallback {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #2A1848, #0E0B2E);
    font-family: var(--font-display); font-size: 32px; font-weight: 300;
    color: rgba(245,167,204,0.4);
    z-index: 0;
  }
  .frame-portrait.no-img img { display: none; }

  /* NAME PLATE */
  .frame-nameplate {
    padding: 8px 6px 10px;
    text-align: center;
    background: #F8F2EC;
    border-top: 0.5px solid rgba(0,0,0,0.08);
  }
  .nameplate-name {
    font-family: var(--font-handwriting, 'Caveat', cursive);
    font-size: 14px; color: #C8C4E0;
    display: block; line-height: 1.2;
  }

  /* BIO OVERLAY */
  .frame-bio {
    position: absolute;
    inset: 0;
    background: rgba(12, 8, 4, 0.92);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s;
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
    z-index: 10;
  }
  .frame-wrap:hover .frame-bio { opacity: 1; }
  .bio-inner { text-align: center; }
  .bio-role { font-size: 9px; color: var(--accent-soft); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px; }
  .bio-name { font-family: var(--font-display); font-size: 16px; font-weight: 300; color: #fff; margin-bottom: 8px; letter-spacing: -0.2px; }
  .bio-text { font-size: 10.5px; color: rgba(255,255,255,0.85); line-height: 1.65; margin-bottom: 10px; }
  .bio-link { font-size: 10px; color: var(--accent-soft); border-bottom: 0.5px solid rgba(245,167,204,0.3); padding-bottom: 1px; transition: border-color 0.2s; display: inline-block; }
  .bio-link:hover { border-color: var(--accent-soft); }

  /* CTA */
  .collab-cta { background: var(--sky, #07051A); padding: 56px 32px; text-align: center; border-top: 0.5px solid var(--border-subtle);  }
  .cta-inner { max-width: 480px; margin: 0 auto; }
  .cta-inner h2 { font-family: var(--font-display); font-size: 32px; font-weight: 300; color: #D4D0F0; margin-bottom: 10px; letter-spacing: -0.5px; }
  .cta-inner p { font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 24px; }
  .btn-cta { display: inline-block; font-size: 14px; font-weight: 500; color: #fff; background: var(--accent, #D4537E); padding: 12px 28px; border-radius: 8px; transition: opacity 0.2s; }
  .btn-cta:hover { opacity: 0.85; }

  /* FOOTER */
  .footer-links a { font-size: 13px; color: #C8C4E0; transition: color 0.2s; }
  .footer-links a:hover { color: #fff; }

  @media (max-width: 768px) {
    .nav-links { display: none; } .nav-burger { display: flex; }
    .gallery-wall { padding: 60px 20px 80px; }
    .frames-container { gap: 32px 20px; }
    .size-large .frame { width: 150px; }
    .size-medium .frame { width: 130px; }
    .size-small .frame { width: 110px; }
    .size-large .frame-portrait { aspect-ratio: 1; height: auto; }
    .size-medium .frame-portrait { aspect-ratio: 1; height: auto; }
    .size-small .frame-portrait { aspect-ratio: 1; height: auto; }
    h1 { letter-spacing: -1px; }
  }
  footer { background: #070520; padding: 32px; border-top: 0.5px solid rgba(255,255,255,0.06); }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
  .footer-logo { font-family: var(--font-logo); font-size: 20px; font-weight: 700; color: #C8C4E0; margin-bottom: 2px; letter-spacing: -0.3px; }
  .footer-sub { font-size: 11px; color: #7F77DD; }
  .footer-address { font-size: 10px; color: #C8C4E0; margin-top: 2px; }
  .footer-credit { font-size: 9px; color: #534AB7; margin-top: 6px; letter-spacing: 0.5px; }
  .footer-middle { text-align: center; }
  .footer-subscribe-label { font-size: 11px; color: #C8C4E0; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .btn-subscribe-footer { font-size: 13px; font-weight: 500; color: #fff; background: #534AB7; padding: 9px 18px; border-radius: 8px; transition: opacity 0.2s; display: inline-block; }
  .btn-subscribe-footer:hover { opacity: 0.85; }
  .footer-links { display: flex; gap: 20px; }
  .footer-links a { font-size: 13px; color: #C8C4E0; transition: color 0.2s; }
  .footer-links a:hover { color: #fff; }
</style>

<script>
  // Mobile menu
  const burger = document.getElementById('burger');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', () => mobileMenu.classList.remove('open'));
  burger?.addEventListener('click', () => mobileMenu.classList.add('open'));
  window.closeMenu = () => mobileMenu.classList.remove('open');

</script>

