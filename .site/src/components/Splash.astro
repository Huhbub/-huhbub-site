---
---
<div id="splash">
  <canvas id="splash-canvas"></canvas>
  <div id="splash-content">
    <div id="splash-wordmark"><span class="logo-text">huhbub</span></div>
    <div id="splash-tagline">creating experiences for creative people</div>
    <div id="splash-enter">
      <span id="splash-dot"></span>
      click anywhere to enter
    </div>
  </div>
</div>

<style>
  #splash {
    position: fixed;
    inset: 0;
    z-index: 1000;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sky, #07051A);
    transition: background 0.5s;
  }

  #splash-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #splash-content {
    position: relative;
    z-index: 2;
    text-align: center;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  #splash-wordmark {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 1.4s ease, transform 1.4s ease;
  }

  .logo-text {
    font-family: 'Nunito', system-ui, sans-serif;
    font-size: clamp(52px, 10vw, 96px);
    font-weight: 600;
    color: var(--accent-soft, #F5A7CC);
    letter-spacing: -2px;
    line-height: 1;
  }

  #splash-tagline {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(11px, 2vw, 14px);
    color: var(--text-secondary, #9B96CC);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-top: 16px;
    opacity: 0;
    transition: opacity 1.2s ease 0.4s;
  }

  #splash-enter {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    color: var(--accent-soft, #F5A7CC);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin-top: 52px;
    opacity: 0;
    transition: opacity 1s ease;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #splash-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent, #D4537E);
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  #splash.is-visible #splash-wordmark {
    opacity: 1;
    transform: translateY(0);
  }

  #splash.is-visible #splash-tagline { opacity: 1; }
  #splash.is-visible #splash-enter { opacity: 1; }

  #splash.is-exiting {
    animation: splashExit 0.9s ease-in forwards;
  }

  @keyframes splashExit {
    0%   { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.06); }
  }
</style>

<script>
(function() {
  const splash = document.getElementById('splash');
  const canvas = document.getElementById('splash-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, frame = 0, objects = [], stars = [], entered = false, animId;
  const moment = window.__huhbubMoment || 'spring-night';
  const [season, time] = moment.split('-');

  // Particle config per moment
  const momentConfig = {
    'spring-dawn':  { types:['blossom','mist'],       colors:['#F5A7CC','#FAC775','#AFA9EC','#F4C0D1'] },
    'spring-day':   { types:['petal','butterfly'],    colors:['#D4537E','#7F77DD','#1D9E75','#F5A7CC'] },
    'spring-dusk':  { types:['lantern','blossom'],    colors:['#F5A7CC','#EF9F27','#7F77DD','#FAC775'] },
    'spring-night': { types:['lantern','balloon'],    colors:['#D4537E','#AFA9EC','#FAC775','#F5A7CC'] },
    'summer-dawn':  { types:['glow','haze'],          colors:['#FAC775','#EF9F27','#F5A7CC','#FAEEDA'] },
    'summer-day':   { types:['firefly','pollen'],     colors:['#EF9F27','#D4537E','#1D9E75','#FAC775'] },
    'summer-dusk':  { types:['balloon','firefly'],    colors:['#D4537E','#FAC775','#AFA9EC','#F5A7CC'] },
    'summer-night': { types:['firefly','balloon'],    colors:['#FAC775','#7F77DD','#F5A7CC','#EF9F27'] },
    'autumn-dawn':  { types:['leaf','mist'],          colors:['#EF9F27','#D85A30','#FAC775','#BA7517'] },
    'autumn-day':   { types:['leaf','petal'],         colors:['#BA7517','#D85A30','#EF9F27','#FAC775'] },
    'autumn-dusk':  { types:['lantern','leaf'],       colors:['#EF9F27','#D4537E','#7F77DD','#D85A30'] },
    'autumn-night': { types:['lantern','ember'],      colors:['#EF9F27','#D85A30','#AFA9EC','#FAC775'] },
    'winter-dawn':  { types:['snow','mist'],          colors:['#B5D4F4','#85B7EB','#F5A7CC','#AFA9EC'] },
    'winter-day':   { types:['snow','frost'],         colors:['#378ADD','#7F77DD','#F5A7CC','#B5D4F4'] },
    'winter-dusk':  { types:['lantern','snow'],       colors:['#AFA9EC','#F5A7CC','#B5D4F4','#7F77DD'] },
    'winter-night': { types:['snow','lantern'],       colors:['#7F77DD','#B5D4F4','#F5A7CC','#AFA9EC'] },
  };

  const cfg = momentConfig[moment] || momentConfig['spring-night'];
  const fallingTypes = ['leaf','snow','frost','petal'];
  const isFalling = (t) => fallingTypes.includes(t);

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }

  function rand(a, b) { return a + Math.random() * (b - a); }

  function makeStars() {
    stars = [];
    if (time === 'day') return;
    const count = time === 'dawn' || time === 'dusk' ? 60 : 160;
    for (let i = 0; i < count; i++) {
      stars.push({ x: Math.random() * W, y: Math.random() * H,
        r: Math.random() * 1.2 + 0.2, o: Math.random() * 0.6 + 0.1,
        tw: Math.random() * Math.PI * 2 });
    }
  }

  function spawnObj(initial = false) {
    const type = cfg.types[Math.floor(Math.random() * cfg.types.length)];
    const col  = cfg.colors[Math.floor(Math.random() * cfg.colors.length)];
    const falling = isFalling(type);
    const x = rand(W * 0.03, W * 0.97);
    const y = initial ? rand(H * 0.05, H * 0.95) : (falling ? -20 : H + 20);
    return {
      type, col, x, y,
      vx: rand(-0.35, 0.35),
      vy: falling ? rand(0.2, 0.55) : rand(-0.55, -0.18),
      r: rand(10, 22),
      alpha: 0, born: frame,
      life: rand(320, 640),
      phase: Math.random() * Math.PI * 2,
      sway: Math.random() * Math.PI * 2,
    };
  }

  function drawStars() {
    stars.forEach(s => {
      const tw = 0.5 + 0.5 * Math.sin(s.tw + frame * 0.018);
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${s.o * tw})`;
      ctx.fill();
    });
  }

  function drawObj(o) {
    const age = frame - o.born;
    const fi  = Math.min(1, age / 50);
    const fo  = age > o.life - 70 ? Math.max(0, (o.life - age) / 70) : 1;
    o.alpha   = fi * fo;
    if (o.alpha <= 0) return;
    ctx.save();
    ctx.globalAlpha = o.alpha;
    const { type, col, x, y, r, phase, sway } = o;

    if (type === 'lantern') {
      // Glow
      ctx.globalAlpha = o.alpha * 0.3;
      const gr = ctx.createRadialGradient(x, y, 0, x, y, r * 2.8);
      gr.addColorStop(0, col + 'cc'); gr.addColorStop(1, col + '00');
      ctx.fillStyle = gr; ctx.beginPath(); ctx.arc(x, y, r * 2.8, 0, Math.PI * 2); ctx.fill();
      // Body
      ctx.globalAlpha = o.alpha;
      ctx.fillStyle = col;
      const h = r * 1.5;
      ctx.beginPath();
      ctx.moveTo(x, y - h * 0.5);
      ctx.bezierCurveTo(x + r * 0.65, y - h * 0.35, x + r * 0.55, y + h * 0.2, x, y + h * 0.5);
      ctx.bezierCurveTo(x - r * 0.55, y + h * 0.2, x - r * 0.65, y - h * 0.35, x, y - h * 0.5);
      ctx.fill();
      // Highlight
      ctx.fillStyle = 'rgba(255,255,255,0.18)';
      ctx.beginPath(); ctx.ellipse(x - r * 0.18, y - r * 0.1, r * 0.16, r * 0.28, -0.4, 0, Math.PI * 2); ctx.fill();
      // Strings
      ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 0.6;
      ctx.beginPath(); ctx.moveTo(x - r * 0.18, y + h * 0.5); ctx.lineTo(x - r * 0.08, y + h * 0.5 + 7); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x + r * 0.18, y + h * 0.5); ctx.lineTo(x + r * 0.08, y + h * 0.5 + 7); ctx.stroke();

    } else if (type === 'balloon') {
      const sw = Math.sin(sway + frame * 0.016) * 0.6;
      const bx = x + sw;
      ctx.globalAlpha = o.alpha * 0.28;
      const gr2 = ctx.createRadialGradient(bx, y, 0, bx, y, r * 3);
      gr2.addColorStop(0, col + 'aa'); gr2.addColorStop(1, col + '00');
      ctx.fillStyle = gr2; ctx.beginPath(); ctx.arc(bx, y, r * 3, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = o.alpha;
      ctx.fillStyle = col; ctx.beginPath(); ctx.arc(bx, y, r, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.beginPath(); ctx.ellipse(bx - r * 0.28, y - r * 0.28, r * 0.22, r * 0.32, -0.5, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.22)'; ctx.lineWidth = 0.7;
      ctx.beginPath(); ctx.moveTo(bx - r * 0.38, y + r); ctx.lineTo(bx, y + r + r * 0.8); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx + r * 0.38, y + r); ctx.lineTo(bx, y + r + r * 0.8); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx, y + r + r * 0.8); ctx.lineTo(bx, y + r + r * 1.4); ctx.stroke();

    } else if (type === 'snow' || type === 'frost') {
      ctx.strokeStyle = col; ctx.lineWidth = 0.9;
      for (let i = 0; i < 6; i++) {
        ctx.save(); ctx.translate(x, y); ctx.rotate(i * Math.PI / 3 + phase);
        ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, r); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, r * 0.5); ctx.lineTo(r * 0.32, r * 0.72); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, r * 0.5); ctx.lineTo(-r * 0.32, r * 0.72); ctx.stroke();
        ctx.restore();
      }

    } else if (type === 'leaf') {
      ctx.fillStyle = col; ctx.save(); ctx.translate(x, y);
      ctx.rotate(phase + frame * 0.025); ctx.beginPath();
      ctx.ellipse(0, 0, r * 0.35, r, 0, 0, Math.PI * 2); ctx.fill(); ctx.restore();

    } else if (type === 'petal' || type === 'blossom') {
      ctx.fillStyle = col + 'bb'; ctx.beginPath(); ctx.arc(x, y, r * 0.55, 0, Math.PI * 2); ctx.fill();

    } else if (type === 'firefly' || type === 'ember') {
      const pulse = 0.5 + 0.5 * Math.sin(phase + frame * 0.1);
      ctx.globalAlpha = o.alpha * pulse;
      const gr3 = ctx.createRadialGradient(x, y, 0, x, y, r * 1.8);
      gr3.addColorStop(0, col + 'ff'); gr3.addColorStop(1, col + '00');
      ctx.fillStyle = gr3; ctx.beginPath(); ctx.arc(x, y, r * 1.8, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = o.alpha;
      ctx.fillStyle = '#ffffffcc'; ctx.beginPath(); ctx.arc(x, y, r * 0.25, 0, Math.PI * 2); ctx.fill();

    } else if (type === 'butterfly') {
      ctx.fillStyle = col; ctx.save(); ctx.translate(x, y);
      ctx.rotate(Math.sin(phase + frame * 0.06) * 0.4);
      ctx.beginPath(); ctx.ellipse(-r * 0.5, 0, r * 0.55, r * 0.38, 0.35, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(r * 0.5, 0, r * 0.55, r * 0.38, -0.35, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

    } else {
      // mist, haze, pollen, glow
      ctx.fillStyle = col + '55'; ctx.beginPath(); ctx.arc(x, y, r * 0.8, 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();
  }

  function loop() {
    ctx.clearRect(0, 0, W, H);
    drawStars();
    if (frame % 50 === 0 && objects.length < 24) objects.push(spawnObj(false));
    objects = objects.filter(o => frame - o.born < o.life);
    objects.forEach(o => { o.x += o.vx; o.y += o.vy; drawObj(o); });
    frame++;
    if (!entered) animId = requestAnimationFrame(loop);
  }

  function init() {
    resize();
    makeStars();
    for (let i = 0; i < 10; i++) {
      const o = spawnObj(true);
      o.born = frame - Math.floor(rand(30, 180));
      objects.push(o);
    }
    loop();

    // Reveal text
    setTimeout(() => splash.classList.add('is-visible'), 200);
    // Show enter prompt
    setTimeout(() => {
      const el = document.getElementById('splash-enter');
      if (el) el.style.opacity = '1';
    }, 1800);
  }

  function enter() {
    if (entered) return;
    entered = true;
    cancelAnimationFrame(animId);
    splash.classList.add('is-exiting');
    setTimeout(() => {
      splash.remove();
      document.body.style.overflow = '';
    }, 900);
  }

  splash.addEventListener('click', enter);
  splash.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') enter(); });
  window.addEventListener('resize', () => { resize(); makeStars(); });

  document.body.style.overflow = 'hidden';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
